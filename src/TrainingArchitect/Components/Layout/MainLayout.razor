@inherits LayoutComponentBase
@inject IOwnerService OwnerService
@inject IHttpContextAccessor HttpContextAccessor
@inject IAboutRepository AboutRepo
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<CascadingValue Value="@(_about?.HeaderTitle ?? "Header Title")" Name="SiteTitle">
<CascadingValue Value="@(_about?.HeaderSubtitle ?? "Header Subtitle")" Name="SiteSubTitle">
<CascadingValue Value="_isOwner" Name="IsOwner">

<nav class="navbar navbar-dark sticky-top" style="background-color: #0d1117;">
    <div class="container" style="max-width: 900px;">

        <!-- Left: Avatar + Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
            <img src="@(!string.IsNullOrEmpty(_about?.AvatarUrl) ? _about.AvatarUrl : "/images/avatar.png")"
                 class="rounded-circle"
                 width="40" height="40"
                 style="object-fit: cover;"
                 alt="Brands Advisory avatar" />
            <div class="lh-sm">
                <div class="fw-bold text-white" style="font-size: 0.875rem;">@(_about?.HeaderTitle ?? "Header Title")</div>
                <div class="text-secondary" style="font-size: 0.7rem;">@(_about?.HeaderSubtitle ?? "Subtitle")</div>
            </div>
        </a>

        <!-- Center: Navigation tabs -->
        <div class="d-flex gap-1">
            <NavLink href="/"
                 Match="NavLinkMatch.All"
                 class="nav-pill-inactive"
                 ActiveClass="nav-pill-active">
                About
            </NavLink>
            <NavLink href="/projects"
                 class="nav-pill-inactive"
                 ActiveClass="nav-pill-active">
                Projects
            </NavLink>
            <NavLink href="/articles"
                 class="nav-pill-inactive"
                 ActiveClass="nav-pill-active">
                Articles
            </NavLink>
            <NavLink href="/coach"
                 class="nav-pill-inactive"
                 ActiveClass="nav-pill-active">
                🚴 Coach
            </NavLink>
            <NavLink href="/training-plan"
                 class="nav-pill-inactive"
                 ActiveClass="nav-pill-active">
                🗓 Plan
            </NavLink>
            <NavLink href="/dashboard"
                 class="nav-pill-inactive"
                 ActiveClass="nav-pill-active">
                📊 Dashboard
            </NavLink>
        </div>

        <!-- Right: Login/Logout -->
        <div class="d-flex align-items-center">
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-outline-secondary btn-sm">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

    </div>
</nav>

<main class="container py-4" style="max-width: 900px;">
    @Body
</main>

<footer class="border-top border-secondary py-3 small" style="background-color: #0d1117;">
    <div class="container d-flex justify-content-between align-items-center" style="max-width: 900px;">
        <span class="text-secondary">&copy; @DateTime.UtcNow.Year @(_about?.FooterCopyright ?? "Brands Advisory")</span>
        <span></span>
        <span class="text-secondary d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(_about?.FooterLink))
            {
                <a href="@_about.FooterLink" class="text-secondary text-decoration-none">@(_about.FooterLinkTitle.Length > 0 ? _about.FooterLinkTitle : _about.FooterLink)</a>
                <span aria-hidden="true">&middot;</span>
            }
            <a href="/legal" class="text-secondary text-decoration-none">Legal</a>
        </span>
    </div>
</footer>

@code {
    private bool _isOwner;
    private AboutContent? _about;

    protected override async Task OnInitializedAsync()
    {
        _about = await AboutRepo.GetOrCreateAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isOwner = OwnerService.IsOwner(authState.User);
    }
}

</CascadingValue>
</CascadingValue>
</CascadingValue>
