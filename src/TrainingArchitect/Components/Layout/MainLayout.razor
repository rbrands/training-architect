@inherits LayoutComponentBase
@inject IOwnerService OwnerService
@inject IAboutRepository AboutRepo
@inject IConfiguration Config
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<CascadingValue Value="@(_about?.HeaderTitle ?? "Header Title")" Name="SiteTitle">
<CascadingValue Value="@(_about?.HeaderSubtitle ?? "Header Subtitle")" Name="SiteSubTitle">
<CascadingValue Value="_isOwner" Name="IsOwner">

<HeadContent>
    @if (CanonicalUrl is not null)
    {
        <link rel="canonical" href="@CanonicalUrl" />
    }
</HeadContent>

<nav class="navbar navbar-light border-bottom sticky-top premium-nav navbar-expand-md">
    <div class="container premium-nav-container" style="max-width: 900px;">
        <div class="premium-nav-toprow">
            <!-- Left: Avatar + Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
                <img src="@(!string.IsNullOrEmpty(_about?.AvatarUrl) ? _about.AvatarUrl : "/images/avatar.png")"
                     width="40" height="40"
                     style="object-fit: cover; border-radius: 12px;"
                     alt="Training Architect logo" />
                <div class="lh-sm">
                    <div class="text-dark brand-name">@(_about?.HeaderTitle ?? "Header Title")</div>
                    <div class="text-secondary brand-subtitle">@(_about?.HeaderSubtitle ?? "Subtitle")</div>
                </div>
            </a>

            <button class="navbar-toggler premium-menu-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#primaryNav"
                    aria-controls="primaryNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <div class="collapse navbar-collapse premium-nav-collapse" id="primaryNav">
            <div class="premium-nav-links">
                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="nav-pill-inactive"
                         ActiveClass="nav-pill-active">
                    Start
                </NavLink>
                <NavLink href="/coach"
                         class="nav-pill-inactive"
                         ActiveClass="nav-pill-active">
                    Coach
                </NavLink>
                <NavLink href="/blog"
                         class="nav-pill-inactive"
                         ActiveClass="nav-pill-active">
                    Blog
                </NavLink>
            </div>
        </div>
    </div>
</nav>

<main class="container py-4" style="max-width: 900px;">
    @Body
</main>

<footer class="border-top py-3 small premium-footer">
    <div class="container d-flex justify-content-between align-items-center" style="max-width: 900px;">
        <span class="text-secondary">&copy; @DateTime.UtcNow.Year @(_about?.FooterCopyright ?? "Brands Advisory")</span>
        <span class="text-secondary app-version">@ApplicationVersionInfo.Current.Display</span>
        <span class="text-secondary d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(_about?.FooterLink))
            {
                <a href="@_about.FooterLink" class="text-secondary text-decoration-none">@(_about.FooterLinkTitle.Length > 0 ? _about.FooterLinkTitle : _about.FooterLink)</a>
                <span aria-hidden="true">&middot;</span>
            }
            <a href="/legal" class="text-secondary text-decoration-none">Legal</a>
        </span>
    </div>
</footer>

@code {
    private bool _isOwner;
    private AboutContent? _about;

    private string? CanonicalUrl
    {
        get
        {
            var siteUrl = Config["SiteUrl"];
            if (string.IsNullOrWhiteSpace(siteUrl)
                || siteUrl.StartsWith("__", StringComparison.Ordinal)
                || !Uri.TryCreate(siteUrl, UriKind.Absolute, out var canonicalBaseUri)
                || !Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var currentUri))
            {
                return null;
            }

            var normalizedPath = NormalizeCanonicalPath(currentUri.AbsolutePath);
            var canonicalUri = new Uri(canonicalBaseUri, normalizedPath);
            return canonicalUri.AbsoluteUri;
        }
    }

    private static string NormalizeCanonicalPath(string absolutePath)
    {
        if (string.IsNullOrWhiteSpace(absolutePath) || absolutePath == "/")
        {
            return "/";
        }

        return absolutePath.TrimEnd('/');
    }

    protected override async Task OnInitializedAsync()
    {
        _about = await AboutRepo.GetOrCreateAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isOwner = OwnerService.IsOwner(authState.User);
    }
}

</CascadingValue>
</CascadingValue>
</CascadingValue>
