@page "/legal"
@inject IAboutRepository AboutRepo

<PageTitle>Legal Notice · @_siteTitle</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">Legal Notice</h1>
    @if (_isOwner)
    {
        <a href="/admin/legal" class="btn btn-outline-secondary btn-sm">Edit</a>
    }
</div>

@if (_isOwner && !HasCompleteProviderDetails)
{
    <div class="alert alert-warning" role="alert">
        Complete the provider name, full postal address, and email address before publishing this legal notice.
    </div>
}

<div class="card-dark p-4">
    <h5 class="fw-semibold mb-2">Service Provider (pursuant to § 5 DDG)</h5>
    <p class="text-secondary">
        @if (!string.IsNullOrEmpty(_about?.LegalServiceProviderName))
        {
            @_about.LegalServiceProviderName<br />
        }
        @if (!string.IsNullOrEmpty(_about?.LegalServiceProviderLocation))
        {
            @_about.LegalServiceProviderLocation
        }
    </p>

    <h5 class="fw-semibold mb-2">Contact</h5>
    <p class="text-secondary">
        @if (!string.IsNullOrEmpty(_about?.LegalContact))
        {
            <span>Email: <a href="@($"mailto:{_about.LegalContact}")">@_about.LegalContact</a></span>
        }
    </p>

    <h5 class="fw-semibold mb-2">Privacy</h5>
    <p class="text-secondary small">
        Information about the processing of personal data, technically necessary cookies,
        connected services, and your rights is available in the <a href="/privacy">Privacy Notice</a>.
    </p>

    <hr class="border-secondary" />

    <h5 class="fw-semibold mb-2">Health Disclaimer</h5>
    <p class="text-secondary small">
        Training Architect is not a medical device and does not provide medical advice, diagnosis or treatment.
        Users remain solely responsible for training, recovery and health-related decisions.
    </p>

    <h5 class="fw-semibold mb-2">Disclaimer</h5>
    <p class="text-secondary small">
        The contents of this website have been compiled with the greatest possible care.
        However, no guarantee can be given for the accuracy, completeness, or timeliness
        of the content. As a service provider, we are responsible for our own content on
        these pages in accordance with general law. Legal obligations to remove or block
        the use of information remain unaffected.
    </p>

    <h5 class="fw-semibold mb-2">Liability for Links</h5>
    <p class="text-secondary small">
        Our website contains links to external third-party websites over whose content
        we have no control. We therefore cannot accept any liability for this external
        content. The respective provider or operator of the linked pages is always
        responsible for their content.
    </p>

    <h5 class="fw-semibold mb-2">Copyright</h5>
    <p class="text-secondary small mb-0">
        The content and works created by the site operator on these pages are subject
        to German copyright law. Reproduction, editing, distribution, and any kind of
        use beyond the limits of copyright law require the written consent of the
        respective author or creator.
    </p>

</div>

@code {
    [CascadingParameter(Name = "IsOwner")]
    private bool _isOwner { get; set; }

    [CascadingParameter(Name = "SiteTitle")]
    private string _siteTitle { get; set; } = "Brands Advisory";

    private AboutContent? _about;

    protected override async Task OnInitializedAsync()
    {
        _about = await AboutRepo.GetOrCreateAsync();
    }

    private bool HasCompleteProviderDetails =>
        !string.IsNullOrWhiteSpace(_about?.LegalServiceProviderName) &&
        !string.IsNullOrWhiteSpace(_about?.LegalServiceProviderLocation) &&
        !string.IsNullOrWhiteSpace(_about?.LegalContact);
}
