@page "/training-plan"
@attribute [StreamRendering]
@inject IAuthContext AuthContext
@inject IConfiguration Config

<PageTitle>Training Plan · Training Architect</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold mb-0">🗓 Training Plan</h1>
    @if (_athlete is not null)
    {
        <span class="badge bg-secondary">@_athlete.Tier</span>
    }
</div>

@if (_athlete is null)
{
    <p class="text-secondary small">
        TODO: Show sign-in prompt once <code>IAuthContext</code> is connected.
    </p>
}

<!-- Plan overview + confirmation (interactive WASM component) -->
<div class="row g-4">
    <div class="col-12 col-lg-8">
        <TrainingPlanViewer Plan="_plan" />
    </div>
    <div class="col-12 col-lg-4">
        <h6 class="text-secondary small fw-semibold mb-2 text-uppercase"
            style="font-size:0.75rem; letter-spacing:0.05em;">
            Confirm this plan
        </h6>
        @*
            PlanConfirmation runs as InteractiveWebAssembly so the athlete
            can interact with the Accept / Adjust / Reject buttons.
            TODO: Route the OnDecision callback into the orchestration layer.
        *@
        <PlanConfirmation @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))"
                          Plan="_plan" />
    </div>
</div>

<p class="text-secondary mt-4" style="font-size:0.7rem;">
    ⚙️ Sample plan — TODO: replace with AI-generated plan from the orchestration layer.
</p>

@code {
    private TrainingArchitect.Core.Models.TrainingPlan _plan = SampleTrainingPlan.Create();
    private AthleteProfile? _athlete;

    protected override async Task OnInitializedAsync()
    {
        // TODO: IAuthContext will be backed by OIDC claims + entitlement store.
        _athlete = await AuthContext.GetAthleteAsync();
    }
}
