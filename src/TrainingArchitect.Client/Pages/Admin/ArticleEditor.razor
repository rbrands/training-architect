@using TrainingArchitect.Client.Models
@page "/admin/articles/{id}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IOwnerService OwnerService
@inject IArticleRepository ArticleRepo
@inject NavigationManager Nav
@inject ClientConfig Config
@inject IJSRuntime JSRuntime

<PageTitle>@(_isNew ? "New Article" : "Edit Article") · @_siteTitle</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">@(_isNew ? "New Article" : "Edit Article")</h2>
    <div class="d-flex gap-2">
        @if (!_isNew)
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="DeleteAsync" disabled="@_deleting"
                    title="Delete article">
                🗑
            </button>
        }
        <button class="btn btn-outline-secondary btn-sm" @onclick="Cancel">Cancel</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saving…" : "Save")
        </button>
    </div>
</div>

@if (!_ready)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-secondary" role="status">
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>
}
else
{
    <div class="card-dark p-4 d-flex flex-column gap-3">

        <div>
            <label class="form-label text-secondary small">Title</label>
                 <input class="form-control"
                   @bind="_article.Title" />
        </div>

        <div>
            <label class="form-label text-secondary small">Slug</label>
                 <input class="form-control"
                   @bind="_article.Slug" />
        </div>

        <div>
            <label class="form-label text-secondary small">Summary</label>
            <textarea class="form-control" rows="3"
                      @bind="_article.Summary"></textarea>
        </div>

        <div>
            <label class="form-label text-secondary small">Tags (comma-separated)</label>
                 <input class="form-control"
                   @bind="_tagsInput" />
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="publishedToggle"
                       @bind="_article.IsPublished" />
                <label class="form-check-label text-secondary small" for="publishedToggle">
                    Published
                </label>
            </div>
        </div>

        <div>
            <label class="form-label text-secondary small">Article Date</label>
            <input class="form-control"
                   type="date"
                   value="@PublishedDateInput"
                   @onchange="OnPublishedDateChanged" />
            @if (_article.PublishedDate.HasValue)
            {
                <div class="form-text text-secondary small">
                    @_article.PublishedDate.Value.ToString("MMMM d, yyyy")
                </div>
            }
        </div>

        <div>
            <label class="form-label text-secondary small">Lifetime</label>
                <select class="form-select"
                    value="@(_article.ExpiresAfterDays?.ToString() ?? "")"
                    @onchange="OnLifetimeChanged">
                <option value="">Unlimited</option>
                <option value="7">1 week</option>
                <option value="28">4 weeks</option>
                <option value="90">3 months</option>
                <option value="180">6 months</option>
                <option value="365">1 year</option>
            </select>
        </div>

        <div>
            <label class="form-label text-secondary small">
                Title Image (optional)
            </label>
            <ImageUploader
                @bind-ImageUrl="_article.TitleImageUrl"
                MaxWidth="1200"
                MaxHeight="630"
                Label="Article title image"
                ShowUrl="false" />
            <div class="form-text text-secondary small">
                Recommended: 1200×630px (Open Graph ratio)
            </div>
        </div>

        <div>
            <label class="form-label text-secondary small">Content</label>
            <SfRichTextEditor EditorMode="EditorMode.Markdown"
                              Value="@_article.Content"
                              ValueChanged="@OnContentChanged"
                              Height="500px">
                <RichTextEditorToolbarSettings Items="@_toolbarItems" />
                <RichTextEditorImageSettings SaveUrl="/api/images/upload"
                                             Path="@Config.ImageContainerUrl" />
                <RichTextEditorEvents OnImageUploadSuccess="@OnImageUploadSuccess" />
            </SfRichTextEditor>
        </div>

    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter(Name = "SiteTitle")]
    private string _siteTitle { get; set; } = "Brands Advisory";

    private Article _article = new();
    private string _tagsInput = string.Empty;
    private bool _isNew;
    private bool _ready;
    private bool _saving;
    private bool _deleting;

    private readonly List<ToolbarItemModel> _toolbarItems =
    [
        new() { Command = ToolbarCommand.Bold },
        new() { Command = ToolbarCommand.Italic },
        new() { Command = ToolbarCommand.Underline },
        new() { Command = ToolbarCommand.Separator },
        new() { Command = ToolbarCommand.Formats },
        new() { Command = ToolbarCommand.OrderedList },
        new() { Command = ToolbarCommand.UnorderedList },
        new() { Command = ToolbarCommand.Separator },
        new() { Command = ToolbarCommand.CreateLink },
        new() { Command = ToolbarCommand.Image },
        new() { Command = ToolbarCommand.Separator },
        new() { Command = ToolbarCommand.SourceCode },
        new() { Command = ToolbarCommand.FullScreen }
    ];

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!OwnerService.IsOwner(authState.User))
        {
            Nav.NavigateTo("/blog");
            return;
        }

        _isNew = string.Equals(Id, "new", StringComparison.OrdinalIgnoreCase);

        if (_isNew)
        {
            _article = new Article
            {
                Id = Guid.NewGuid().ToString(),
                PublishedDate = DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc)
            };
        }
        else
        {
            var existing = await ArticleRepo.GetByIdAsync(Id);
            if (existing is null)
            {
                Nav.NavigateTo("/blog");
                return;
            }
            _article = existing;
            _tagsInput = string.Join(", ", _article.Tags);
        }

        _ready = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;

        _article.Tags = _tagsInput
            .Split(',')
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();

        _article.Slug = NormalizeSlug(_article.Slug);
        if (string.IsNullOrWhiteSpace(_article.Slug))
            _article.Slug = NormalizeSlug(_article.Title);

        if (_article.IsPublished && _article.PublishedDate is null)
            _article.PublishedDate = DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc);

        await ArticleRepo.UpsertAsync(_article);
        Nav.NavigateTo($"/blog/{_article.Slug}");
    }

    private static string NormalizeSlug(string value)
    {
        var slug = value.Trim().ToLowerInvariant();

        slug = System.Text.RegularExpressions.Regex.Replace(slug, "[^a-z0-9]+", "-");
        slug = slug.Trim('-');

        return slug;
    }

    private void OnLifetimeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _article.ExpiresAfterDays = int.TryParse(value, out var days) ? days : null;
    }

    private string PublishedDateInput => _article.PublishedDate?.ToString("yyyy-MM-dd") ?? string.Empty;

    private void OnPublishedDateChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            _article.PublishedDate = null;
            return;
        }

        if (DateTime.TryParse(value, out var parsedDate))
            _article.PublishedDate = DateTime.SpecifyKind(parsedDate.Date, DateTimeKind.Utc);
    }

    // OnImageUploadSuccess fires BEFORE ValueChanged updates _article.Content.
    // Store the pending fix here; OnContentChanged applies it when ValueChanged fires.
    private string? _pendingBlobUrl;
    private IReadOnlyList<string>? _pendingWrongSrcCandidates;

    private void OnImageUploadSuccess(ImageSuccessEventArgs args)
    {
        var blobUrl = ExtractBlobUrl(args);
        if (string.IsNullOrEmpty(blobUrl)) return;

        _pendingBlobUrl = blobUrl;
        _pendingWrongSrcCandidates = GetWrongSrcCandidates(args.File?.Name).ToArray();
    }

    private async Task OnContentChanged(string value)
    {
        string? replacedSrc = null;
        string? correctSrc = null;

        if (_pendingBlobUrl is not null && _pendingWrongSrcCandidates is not null)
        {
            foreach (var wrongSrc in _pendingWrongSrcCandidates)
            {
                if (value.Contains(wrongSrc, StringComparison.OrdinalIgnoreCase))
                {
                    value = value.Replace(wrongSrc, _pendingBlobUrl, StringComparison.OrdinalIgnoreCase);
                    replacedSrc = wrongSrc;
                    correctSrc = _pendingBlobUrl;
                }
            }

            _pendingBlobUrl = null;
            _pendingWrongSrcCandidates = null;
        }

        _article.Content = value;

        // Also patch the editor DOM so the image displays immediately.
        if (!string.IsNullOrEmpty(replacedSrc) && !string.IsNullOrEmpty(correctSrc))
            await JSRuntime.InvokeVoidAsync("sfFixImageSrc", replacedSrc, correctSrc);
    }

    private IEnumerable<string> GetWrongSrcCandidates(string? fileName)
    {
        var candidates = new List<string>();
        var containerUrl = Config.ImageContainerUrl?.TrimEnd('/') ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(fileName))
        {
            candidates.Add($"{containerUrl}/{fileName}");
            candidates.Add($"/images/{fileName}");
            candidates.Add($"images/{fileName}");
            candidates.Add(fileName.TrimStart('/'));
        }

        return candidates
            .Where(static candidate => !string.IsNullOrWhiteSpace(candidate))
            .Distinct(StringComparer.OrdinalIgnoreCase);
    }

    private static string? ExtractBlobUrl(ImageSuccessEventArgs args)
    {
        // Syncfusion's ResponseEventArgs exposes response headers but not the body.
        // The endpoint sets X-Blob-Url so we can retrieve the correct GUID blob URL here.
        if (string.IsNullOrEmpty(args.Response?.Headers)) return null;
        foreach (var line in args.Response.Headers.Split(["\r\n", "\n"], StringSplitOptions.RemoveEmptyEntries))
        {
            if (line.StartsWith("x-blob-url:", StringComparison.OrdinalIgnoreCase))
                return line["x-blob-url:".Length..].Trim();
        }
        return null;
    }

    private void Cancel() => Nav.NavigateTo("/blog");

    private async Task DeleteAsync()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Delete '{_article.Title}'? This cannot be undone."))
            return;

        _deleting = true;
        await ArticleRepo.DeleteAsync(_article.Id);
        Nav.NavigateTo("/blog");
    }
}
