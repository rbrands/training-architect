@page "/admin"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IOwnerService OwnerService
@inject IAthleteRepository AthleteRepository
@inject ILevelRepository LevelRepository
@inject IUsageCounterRepository UsageCounterRepository
@inject NavigationManager Nav

<PageTitle>Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Admin</h2>
</div>

<div class="admin-page">
    <SfTab CssClass="admin-tabs">
        <TabItems>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Usage" />
                </ChildContent>
                <ContentTemplate>
                    <div class="card-dark p-4">
                        @if (_loading)
                        {
                            <div class="d-flex justify-content-center py-4">
                                <div class="spinner-border text-secondary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_loadError))
                        {
                            <div class="alert alert-danger mb-0" role="alert">
                                @_loadError
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
                                <div>
                                    <label class="form-label text-secondary small mb-1">Scope</label>
                                    <select class="form-select form-select-sm" @bind="ScopeFilter">
                                        <option value="all">All</option>
                                        <option value="global">Global only</option>
                                        <option value="athlete">Athletes only</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="form-label text-secondary small mb-1">Type</label>
                                    <select class="form-select form-select-sm" @bind="UsageTypeFilter">
                                        <option value="all">All</option>
                                        <option value="monthly_usage">Monthly</option>
                                        <option value="weekly_usage">Weekly</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="form-label text-secondary small mb-1">Athlete</label>
                                    <input class="form-control form-control-sm"
                                           @bind="AthleteFilter"
                                           placeholder="contains..." />
                                </div>

                                <div>
                                    <label class="form-label text-secondary small mb-1">Period</label>
                                    <input class="form-control form-control-sm"
                                           @bind="PeriodFilter"
                                           placeholder="e.g. 2026-07 or 2026-W31" />
                                </div>

                                <div>
                                    <label class="form-label text-secondary small mb-1">Action</label>
                                    <input class="form-control form-control-sm"
                                           @bind="ActionFilter"
                                           placeholder="contains..." />
                                </div>

                                <button class="btn btn-outline-primary btn-sm" @onclick="ReloadUsageAsync">Refresh</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear</button>
                            </div>

                            <div class="text-secondary small mb-2">
                                Showing @FilteredUsageRows.Count of @_allUsageRows.Count records
                            </div>

                            <SfGrid DataSource="@FilteredUsageRows" AllowPaging="true" AllowSorting="true" Width="100%">
                                <GridPageSettings PageSize="40" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(UsageGridRow.UpdatedAt)" HeaderText="Updated" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm" Width="150" />
                                    <GridColumn Field="@nameof(UsageGridRow.UsageType)" HeaderText="Type" Width="120" />
                                    <GridColumn Field="@nameof(UsageGridRow.PeriodKey)" HeaderText="Period" Width="100" />
                                    <GridColumn Field="@nameof(UsageGridRow.AthleteId)" HeaderText="Athlete" Width="120" />
                                    <GridColumn Field="@nameof(UsageGridRow.TotalInputTokens)" HeaderText="Input" TextAlign="TextAlign.Right" Width="110" />
                                    <GridColumn Field="@nameof(UsageGridRow.TotalCachedTokens)" HeaderText="Cached" TextAlign="TextAlign.Right" Width="110" />
                                    <GridColumn Field="@nameof(UsageGridRow.TotalOutputTokens)" HeaderText="Output" TextAlign="TextAlign.Right" Width="110" />
                                    <GridColumn Field="@nameof(UsageGridRow.ActionSummary)" HeaderText="Actions" Width="450" />
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Levels" />
                </ChildContent>
                <ContentTemplate>
                    <div class="card-dark p-4 d-flex flex-column gap-4">
                        @if (_levelsLoading)
                        {
                            <div class="d-flex justify-content-center py-4">
                                <div class="spinner-border text-secondary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_levelsLoadError))
                        {
                            <div class="alert alert-danger mb-0" role="alert">
                                @_levelsLoadError
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                                <div class="text-secondary small">
                                    Select a level in the grid to edit details and limits.
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="NewLevelAsync">New Level</button>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="ReloadLevelsAsync">Refresh</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelectedLevel">Clear</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="DeleteLevelAsync" disabled="@_levelSaving || _selectedLevel is null || _isCreatingLevel">
                                        Delete
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="SaveLevelAsync" disabled="@_levelSaving">
                                        @(_levelSaving ? "Saving…" : "Save")
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_levelActionError))
                            {
                                <div class="alert alert-danger mb-0" role="alert">
                                    @_levelActionError
                                </div>
                            }

                            <SfGrid TValue="LevelGridRow"
                                    DataSource="@_levelRows"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    Height="320"
                                    Width="100%">
                                <GridSelectionSettings Mode="SelectionMode.Row" Type="Syncfusion.Blazor.Grids.SelectionType.Single" />
                                <GridEvents TValue="LevelGridRow" RowSelected="OnLevelRowSelected" />
                                <GridPageSettings PageSize="20" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(LevelGridRow.Id)" HeaderText="ID" Width="180" />
                                    <GridColumn Field="@nameof(LevelGridRow.Level)" HeaderText="Level" Width="120" />
                                    <GridColumn Field="@nameof(LevelGridRow.Label)" HeaderText="Label" Width="180" />
                                    <GridColumn Field="@nameof(LevelGridRow.UpdatedAt)" HeaderText="Updated" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm" Width="150" />
                                </GridColumns>
                            </SfGrid>

                            @if (_selectedLevel is not null)
                            {
                                <div class="border-top border-secondary-subtle pt-4 d-flex flex-column gap-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold text-white">@(_isCreatingLevel ? "New Level" : "Edit Level")</div>
                                            <div class="text-secondary small">@_selectedLevel.Id</div>
                                        </div>
                                        <div class="text-secondary small">
                                            Last updated: @_selectedLevel.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-secondary small">Level Key</label>
                                            @if (_isCreatingLevel)
                                            {
                                                <input class="form-control"
                                                       placeholder="e.g. basic"
                                                       @bind-value="_selectedLevel.Level"
                                                       @bind-value:event="oninput" />
                                            }
                                            else
                                            {
                                                <input class="form-control" @bind-value="_selectedLevel.Level" readonly />
                                            }
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-secondary small">Label</label>
                                            <input class="form-control" @bind="_selectedLevel.Label" />
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-secondary small">Type</label>
                                            <div class="form-control bg-body-tertiary text-secondary" aria-readonly="true">@_selectedLevel.Type</div>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Plan Create</div>
                                                <div class="text-secondary small mb-3">Limit for creating a new training plan</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.PlanCreate.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.PlanCreate.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Assess Metrics</div>
                                                <div class="text-secondary small mb-3">Limit for metric assessments</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.AssessMetrics.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.AssessMetrics.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Assess Last Training</div>
                                                <div class="text-secondary small mb-3">Limit for the last training session assessment</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.AssessLastTraining.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.AssessLastTraining.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Assess Week</div>
                                                <div class="text-secondary small mb-3">Limit for the weekly assessment flow</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.AssessWeek.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedLevel.Limits.AssessWeek.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-secondary small">
                                    No level selected.
                                </div>
                            }
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Athletes" />
                </ChildContent>
                <ContentTemplate>
                    <div class="card-dark p-4 d-flex flex-column gap-4">
                        @if (_athletesLoading)
                        {
                            <div class="d-flex justify-content-center py-4">
                                <div class="spinner-border text-secondary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_athletesLoadError))
                        {
                            <div class="alert alert-danger mb-0" role="alert">
                                @_athletesLoadError
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                                <div class="text-secondary small">
                                    Select an athlete in the grid to edit the configuration.
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="NewAthleteAsync">New Athlete</button>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="ReloadAthletesAsync">Refresh</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelectedAthlete">Clear</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="DeleteAthleteAsync" disabled="@_athleteSaving || _selectedAthlete is null || _isCreatingAthlete">
                                        Delete
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="SaveAthleteAsync" disabled="@_athleteSaving">
                                        @(_athleteSaving ? "Saving…" : "Save")
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_athleteActionError))
                            {
                                <div class="alert alert-danger mb-0" role="alert">
                                    @_athleteActionError
                                </div>
                            }

                            <SfGrid TValue="AthleteGridRow"
                                    DataSource="@_athleteRows"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    Height="420"
                                    Width="100%">
                                <GridSelectionSettings Mode="SelectionMode.Row" Type="Syncfusion.Blazor.Grids.SelectionType.Single" />
                                <GridEvents TValue="AthleteGridRow" RowSelected="OnAthleteRowSelected" />
                                <GridPageSettings PageSize="20" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(AthleteGridRow.AthleteId)" HeaderText="Athlete" Width="140" />
                                    <GridColumn Field="@nameof(AthleteGridRow.Level)" HeaderText="Level" Width="100" />
                                    <GridColumn Field="@nameof(AthleteGridRow.Locked)" HeaderText="Locked" Width="110" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var row = context as AthleteGridRow; }
                                            <span class="badge @(row?.Locked == true ? "text-bg-success" : "text-bg-secondary")">
                                                @(row?.Locked == true ? "Locked" : "Open")
                                            </span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(AthleteGridRow.Message)" HeaderText="Message" Width="240" />
                                    <GridColumn Field="@nameof(AthleteGridRow.PlanCreateWeekly)" HeaderText="Plan W" TextAlign="TextAlign.Right" Width="80" />
                                    <GridColumn Field="@nameof(AthleteGridRow.PlanCreateMonthly)" HeaderText="Plan M" TextAlign="TextAlign.Right" Width="80" />
                                    <GridColumn Field="@nameof(AthleteGridRow.AssessMetricsWeekly)" HeaderText="Metrics W" TextAlign="TextAlign.Right" Width="90" />
                                    <GridColumn Field="@nameof(AthleteGridRow.AssessMetricsMonthly)" HeaderText="Metrics M" TextAlign="TextAlign.Right" Width="90" />
                                    <GridColumn Field="@nameof(AthleteGridRow.AssessLastTrainingWeekly)" HeaderText="Last W" TextAlign="TextAlign.Right" Width="80" />
                                    <GridColumn Field="@nameof(AthleteGridRow.AssessLastTrainingMonthly)" HeaderText="Last M" TextAlign="TextAlign.Right" Width="80" />
                                    <GridColumn Field="@nameof(AthleteGridRow.AssessWeekWeekly)" HeaderText="Week W" TextAlign="TextAlign.Right" Width="80" />
                                    <GridColumn Field="@nameof(AthleteGridRow.AssessWeekMonthly)" HeaderText="Week M" TextAlign="TextAlign.Right" Width="80" />
                                </GridColumns>
                            </SfGrid>

                            @if (_selectedAthlete is not null)
                            {
                                <div class="border-top border-secondary-subtle pt-4 d-flex flex-column gap-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold text-white">@(_isCreatingAthlete ? "New Athlete" : "Edit Athlete")</div>
                                            <div class="text-secondary small">@_selectedAthlete.AthleteId</div>
                                        </div>
                                        <div class="text-secondary small">
                                            Last updated: @_selectedAthlete.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-secondary small">Athlete ID</label>
                                            @if (_isCreatingAthlete)
                                            {
                                                <input class="form-control"
                                                       placeholder="e.g. i57401"
                                                       @bind-value="_selectedAthlete.AthleteId"
                                                       @bind-value:event="oninput" />
                                            }
                                            else
                                            {
                                                <input class="form-control" @bind-value="_selectedAthlete.AthleteId" readonly />
                                            }
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-secondary small">Level</label>
                                            <select class="form-select" @bind="_selectedAthlete.Level">
                                                @foreach (var levelOption in GetAthleteLevelOptions(_selectedAthlete.Level))
                                                {
                                                    <option value="@levelOption">@levelOption</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-12 col-md-4 d-flex align-items-end">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" id="athleteLockedToggle" @bind="_selectedAthlete.Locked" />
                                                <label class="form-check-label text-secondary small" for="athleteLockedToggle">Locked</label>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label text-secondary small">Message</label>
                                            <textarea class="form-control" rows="2" @bind="_selectedAthlete.Message"></textarea>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Plan Create</div>
                                                <div class="text-secondary small mb-3">Limit for creating a new training plan</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.PlanCreate.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.PlanCreate.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Assess Metrics</div>
                                                <div class="text-secondary small mb-3">Limit for metric assessments</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.AssessMetrics.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.AssessMetrics.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Assess Last Training</div>
                                                <div class="text-secondary small mb-3">Limit for the last training session assessment</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.AssessLastTraining.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.AssessLastTraining.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-6">
                                            <div class="card-dark border border-secondary-subtle p-3 h-100">
                                                <div class="fw-semibold text-white mb-1">Assess Week</div>
                                                <div class="text-secondary small mb-3">Limit for the weekly assessment flow</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Weekly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.AssessWeek.Weekly" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label text-secondary small">Monthly</label>
                                                        <input class="form-control" type="number" min="0" @bind="_selectedAthlete.Limits.AssessWeek.Monthly" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-secondary small">
                                    No athlete selected.
                                </div>
                            }
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
</div>

@code {
    private bool _loading = true;
    private string? _loadError;
    private IReadOnlyList<UsageGridRow> _allUsageRows = [];
    private bool _athletesLoading = true;
    private string? _athletesLoadError;
    private IReadOnlyList<AthleteGridRow> _athleteRows = [];
    private AthleteConfig? _selectedAthlete;
    private bool _athleteSaving;
    private bool _isCreatingAthlete;
    private string? _athleteActionError;
    private bool _levelsLoading = true;
    private string? _levelsLoadError;
    private IReadOnlyList<LevelGridRow> _levelRows = [];
    private LevelConfig? _selectedLevel;
    private bool _levelSaving;
    private bool _isCreatingLevel;
    private string? _levelActionError;
    private string _scopeFilter = "all";
    private string _usageTypeFilter = "all";
    private string _athleteFilter = string.Empty;
    private string _periodFilter = string.Empty;
    private string _actionFilter = string.Empty;
    private IReadOnlyList<UsageGridRow>? _filteredUsageRows;

    private string ScopeFilter
    {
        get => _scopeFilter;
        set => SetFilter(ref _scopeFilter, value);
    }

    private string UsageTypeFilter
    {
        get => _usageTypeFilter;
        set => SetFilter(ref _usageTypeFilter, value);
    }

    private string AthleteFilter
    {
        get => _athleteFilter;
        set => SetFilter(ref _athleteFilter, value);
    }

    private string PeriodFilter
    {
        get => _periodFilter;
        set => SetFilter(ref _periodFilter, value);
    }

    private string ActionFilter
    {
        get => _actionFilter;
        set => SetFilter(ref _actionFilter, value);
    }

    private IReadOnlyList<UsageGridRow> FilteredUsageRows => _filteredUsageRows ??= _allUsageRows
        .Where(MatchesScope)
        .Where(MatchesUsageType)
        .Where(MatchesAthlete)
        .Where(MatchesPeriod)
        .Where(MatchesAction)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!OwnerService.IsOwner(authState.User))
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadUsageAsync();
        await LoadLevelsAsync();
        await LoadAthletesAsync();
    }

    private async Task ReloadLevelsAsync()
    {
        await LoadLevelsAsync();
    }

    private async Task ReloadAthletesAsync()
    {
        await LoadAthletesAsync();
    }

    private async Task ReloadUsageAsync()
    {
        await LoadUsageAsync();
    }

    private async Task LoadLevelsAsync()
    {
        _levelsLoading = true;
        _levelsLoadError = null;

        try
        {
            var documents = await LevelRepository.GetAllAsync();
            _levelRows = documents
                .OrderBy(d => d.Level, StringComparer.OrdinalIgnoreCase)
                .Select(ToLevelGridRow)
                .ToList();

            if (_selectedLevel is not null && !_isCreatingLevel)
            {
                var refreshed = documents.FirstOrDefault(d => string.Equals(d.Id, _selectedLevel.Id, StringComparison.Ordinal));
                _selectedLevel = refreshed is null ? null : CloneLevelConfig(refreshed);
            }

            if (_selectedLevel is null && !_isCreatingLevel && _levelRows.Count > 0)
            {
                _selectedLevel = CloneLevelConfig(_levelRows[0].ToModel());
            }
        }
        catch (Exception ex)
        {
            _levelsLoadError = $"Level configs could not be loaded: {ex.Message}";
        }
        finally
        {
            _levelsLoading = false;
        }
    }

    private async Task LoadAthletesAsync()
    {
        _athletesLoading = true;
        _athletesLoadError = null;

        try
        {
            var documents = await AthleteRepository.GetAllAsync();
            _athleteRows = documents
                .OrderByDescending(d => d.UpdatedAt)
                .Select(ToGridRow)
                .ToList();

            if (_selectedAthlete is not null && !_isCreatingAthlete)
            {
                var refreshed = documents.FirstOrDefault(d => string.Equals(d.AthleteId, _selectedAthlete.AthleteId, StringComparison.Ordinal));
                _selectedAthlete = refreshed is null ? null : CloneAthleteConfig(refreshed);
            }

            if (_selectedAthlete is null && !_isCreatingAthlete && _athleteRows.Count > 0)
            {
                _selectedAthlete = CloneAthleteConfig(_athleteRows[0].ToModel());
            }
        }
        catch (Exception ex)
        {
            _athletesLoadError = $"Athlete configs could not be loaded: {ex.Message}";
        }
        finally
        {
            _athletesLoading = false;
        }
    }

    private async Task LoadUsageAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var documents = await UsageCounterRepository.GetAllAsync();
            _allUsageRows = documents
                .OrderByDescending(d => d.UpdatedAt)
                .Select(d => new UsageGridRow
                {
                    AthleteId = d.AthleteId,
                    UsageType = d.UsageType,
                    PeriodKey = d.PeriodKey,
                    TotalInputTokens = d.TotalInputTokens,
                    TotalCachedTokens = d.TotalCachedTokens,
                    TotalOutputTokens = d.TotalOutputTokens,
                    UpdatedAt = d.UpdatedAt,
                    ActionSummary = BuildActionSummary(d.Counts)
                })
                .ToList();
            _filteredUsageRows = null;
        }
        catch (Exception ex)
        {
            _loadError = $"Usage records could not be loaded: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearFilters()
    {
        ScopeFilter = "all";
        UsageTypeFilter = "all";
        AthleteFilter = string.Empty;
        PeriodFilter = string.Empty;
        ActionFilter = string.Empty;
    }

    private void SetFilter(ref string field, string value)
    {
        if (string.Equals(field, value, StringComparison.Ordinal))
        {
            return;
        }

        field = value;
        _filteredUsageRows = null;
    }

