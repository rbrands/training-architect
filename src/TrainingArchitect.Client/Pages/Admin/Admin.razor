    private IReadOnlyList<string> GetAthleteLevelOptions(string? selectedLevel)
    {
        var levels = _levelRows
            .Select(r => r.Level)
            .Where(level => !string.IsNullOrWhiteSpace(level))
            .Select(level => level.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(level => level, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (levels.Count == 0)
        {
            levels.Add("basic");
        }

        if (!string.IsNullOrWhiteSpace(selectedLevel)
            && !levels.Contains(selectedLevel, StringComparer.OrdinalIgnoreCase))
        {
            levels.Add(selectedLevel);
        }

        return levels;
    }

