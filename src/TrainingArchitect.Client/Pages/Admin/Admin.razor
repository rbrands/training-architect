    private bool MatchesScope(UsageGridRow row)
    {
        return _scopeFilter switch
        {
            "global" => string.Equals(row.AthleteId, "__GLOBAL__", StringComparison.Ordinal),
            "athlete" => !string.Equals(row.AthleteId, "__GLOBAL__", StringComparison.Ordinal),
            _ => true
        };
    }

    private bool MatchesUsageType(UsageGridRow row)
    {
        if (string.Equals(_usageTypeFilter, "all", StringComparison.Ordinal))
        {
            return true;
        }

        return string.Equals(row.UsageType, _usageTypeFilter, StringComparison.Ordinal);
    }

    private bool MatchesAthlete(UsageGridRow row)
    {
        if (string.IsNullOrWhiteSpace(_athleteFilter))
        {
            return true;
        }

        return row.AthleteId.Contains(_athleteFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesPeriod(UsageGridRow row)
    {
        if (string.IsNullOrWhiteSpace(_periodFilter))
        {
            return true;
        }

        return row.PeriodKey.Contains(_periodFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesAction(UsageGridRow row)
    {
        if (string.IsNullOrWhiteSpace(_actionFilter))
        {
            return true;
        }

        return row.ActionSummary.Contains(_actionFilter, StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildActionSummary(IReadOnlyDictionary<string, int> counts)
    {
        if (counts.Count == 0)
        {
            return "-";
        }

        return string.Join(", ", counts
            .OrderByDescending(kvp => kvp.Value)
            .ThenBy(kvp => kvp.Key, StringComparer.Ordinal)
            .Select(kvp => $"{kvp.Key}: {kvp.Value}"));
    }

    private static AthleteGridRow ToGridRow(AthleteConfig config)
    {
        return new AthleteGridRow
        {
            AthleteId = config.AthleteId,
            Level = config.Level,
            Locked = config.Locked,
            Message = config.Message,
            PlanCreateWeekly = config.Limits.PlanCreate.Weekly,
            PlanCreateMonthly = config.Limits.PlanCreate.Monthly,
            AssessMetricsWeekly = config.Limits.AssessMetrics.Weekly,
            AssessMetricsMonthly = config.Limits.AssessMetrics.Monthly,
            AssessLastTrainingWeekly = config.Limits.AssessLastTraining.Weekly,
            AssessLastTrainingMonthly = config.Limits.AssessLastTraining.Monthly,
            AssessWeekWeekly = config.Limits.AssessWeek.Weekly,
            AssessWeekMonthly = config.Limits.AssessWeek.Monthly,
            UpdatedAt = config.UpdatedAt
        };
    }

    private static AthleteConfig CloneAthleteConfig(AthleteConfig source)
    {
        return new AthleteConfig
        {
            Id = source.Id,
            AthleteId = source.AthleteId,
            Level = source.Level,
            Limits = new AthleteLimits
            {
                PlanCreate = new AthleteLimitWindow
                {
                    Weekly = source.Limits.PlanCreate.Weekly,
                    Monthly = source.Limits.PlanCreate.Monthly
                },
                AssessMetrics = new AthleteLimitWindow
                {
                    Weekly = source.Limits.AssessMetrics.Weekly,
                    Monthly = source.Limits.AssessMetrics.Monthly
                },
                AssessLastTraining = new AthleteLimitWindow
                {
                    Weekly = source.Limits.AssessLastTraining.Weekly,
                    Monthly = source.Limits.AssessLastTraining.Monthly
                },
                AssessWeek = new AthleteLimitWindow
                {
                    Weekly = source.Limits.AssessWeek.Weekly,
                    Monthly = source.Limits.AssessWeek.Monthly
                }
            },
            Locked = source.Locked,
            Message = source.Message,
            CreatedAt = source.CreatedAt,
            UpdatedAt = source.UpdatedAt,
            TimeToLive = source.TimeToLive
        };
    }

