    }

    private Task NewLevelAsync()
    {
        _levelActionError = null;
        _isCreatingLevel = true;
        _selectedLevel = CreateBlankLevelConfig();
        return Task.CompletedTask;
    }

    private async Task SaveLevelAsync()
    {
        if (_selectedLevel is null)
        {
            return;
        }

        _levelActionError = null;
        _levelSaving = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_selectedLevel.Level))
            {
                _levelActionError = "Level key is required.";
                return;
            }

            _selectedLevel.Level = _selectedLevel.Level.Trim();
            _selectedLevel.Label = _selectedLevel.Label.Trim();

            var saved = await LevelRepository.UpsertAsync(_selectedLevel);
            _isCreatingLevel = false;
            _selectedLevel = CloneLevelConfig(saved);
            await LoadLevelsAsync();
        }
        catch (Exception ex)
        {
            _levelActionError = $"Level config could not be saved: {ex.Message}";
        }
        finally
        {
            _levelSaving = false;
        }
    }

    private async Task DeleteLevelAsync()
    {
        if (_selectedLevel is null)
        {
            return;
        }

        _levelActionError = null;
        _levelSaving = true;

        try
        {
            await LevelRepository.DeleteAsync(_selectedLevel.Id);
            _isCreatingLevel = false;
            _selectedLevel = null;
            await LoadLevelsAsync();
        }
        catch (Exception ex)
        {
            _levelActionError = $"Level config could not be deleted: {ex.Message}";
        }
        finally
        {
            _levelSaving = false;
        }
    }

