@page "/coach"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IAthleteSession Session
@inject ICredentialStore CredentialStore
@inject CoachPageState CoachPageState
@inject IJSRuntime JS
@inject HttpClient Http
@using Markdig
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Linq
@using TrainingArchitect.Core.Constants
@using TrainingArchitect.Core.Models
@implements IDisposable


<PageTitle>AI Coach · Training Architect</PageTitle>

<div class="coach-page">
    @if (!string.IsNullOrWhiteSpace(_initializationError))
    {
        <div class="alert alert-warning" role="alert">
            @_initializationError
        </div>
    }

    <header class="coach-page-header">
        <h1 class="fw-bold mb-2">AI Coach</h1>
        <p class="coach-page-subtitle mb-0">
            Understand your current state and start with the most useful coaching entry points.
        </p>
    </header>

    <SfCard CssClass="coach-status-card">
        <CardContent>
            <div class="coach-status-layout">
                <div class="coach-status-copy">
                    <div class="coach-status-topline @StatusCssClass">
                        <span class="coach-status-badge" aria-hidden="true">
                            <i class="bi @StatusIconClass"></i>
                        </span>
                        <span class="coach-status-title">@StatusText@AthleteSuffix</span>
                        @if (ShowLevelLabelBadge)
                        {
                            <span class="coach-level-badge" title="Configured athlete level label">
                                @Session.LevelLabel
                            </span>
                        }
                        @if (Session.State == CoachConnectionState.Connected)
                        {
                            <button type="button"
                                    class="coach-status-copy-json"
                                    title="Copy athlete JSON"
                                    aria-label="Copy athlete JSON"
                                    disabled="@(!CanViewData)"
                                    @onclick="CopyAthleteJsonAsync">
                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_statusCopyFeedback))
                    {
                        <div class="coach-status-copy-feedback">@_statusCopyFeedback</div>
                    }
                    @if (ShowRememberedNote)
                    {
                        <div class="coach-status-note">
                            <i class="bi bi-key"></i>
                            <span>API key remembered on this device</span>
                        </div>
                    }
                </div>

                <div class="coach-status-actions">
                    <button type="button"
                            class="coach-inline-link"
                            disabled="@(!CanViewData)"
                            @onclick="OpenDataView">
                        View Data
                    </button>
                    @if (Session.State == CoachConnectionState.Connected)
                    {
                        <button type="button"
                                class="coach-inline-link"
                                @onclick="RefreshAsync"
                                disabled="@(!CanRefresh)">
                            @(Session.IsRefreshing ? "Refreshing..." : "Refresh")
                        </button>

                        <button type="button"
                                class="coach-inline-link coach-inline-link-muted"
                                @onclick="DisconnectAsync"
                                disabled="@IsActionBusy">
                            Disconnect
                        </button>
                    }
                </div>
            </div>

            @if (CanConnect)
            {
                <div class="credential-form">
                    <h2>Connect to intervals.icu</h2>
                    <p class="subtitle subtitle-with-help">
                        <span>Enter your Athlete ID and API key to load your training data.</span>
                        <button type="button"
                                class="credential-help-inline-trigger"
                                title="Show where to find Athlete ID and API Key"
                                aria-label="Show where to find Athlete ID and API Key"
                                aria-expanded="@_showCredentialHelp"
                                aria-controls="credential-help-modal"
                                @onclick="ToggleCredentialHelp">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>Where to find these values</span>
                        </button>
                    </p>

                    <label class="field">
                        <span>Athlete ID</span>
                        <input type="text"
                               autocomplete="off"
                               placeholder="e.g. 12345"
                               disabled="@IsBusy"
                               @bind="_athleteId" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>API Key</span>
                        <input type="password"
                               autocomplete="off"
                               placeholder="Your intervals.icu API key"
                               disabled="@IsBusy"
                               @bind="_apiKey" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>Language</span>
                        <select disabled="@IsBusy" @bind="_language">
                            <option value="@CoachLanguage.English">English</option>
                            <option value="@CoachLanguage.German">German</option>
                            <option value="@CoachLanguage.Spanish">Spanish</option>
                            <option value="@CoachLanguage.French">French</option>
                        </select>
                    </label>

                    <label class="field">
                        <span class="field-label-with-help">
                            <span>Athlete Goal</span>
                            <a class="field-help-link"
                               href="/blog/athlete-goals"
                               title="Read more about athlete goals"
                               aria-label="Read more about athlete goals">
                                <i class="bi bi-question-circle" aria-hidden="true"></i>
                            </a>
                        </span>
                        <select disabled="@IsBusy" @bind="_profileGoal">
                            <option value="@AthleteProfileGoal.Climber">Climber</option>
                            <option value="@AthleteProfileGoal.Criterium">Criterium</option>
                            <option value="@AthleteProfileGoal.Marathon">Marathon</option>
                            <option value="@AthleteProfileGoal.RoadRace">Road Race</option>
                        </select>
                    </label>

                    <label class="remember">
                        <input type="checkbox" disabled="@IsBusy" @bind="_remember" />
                        <span>Remember on this device</span>
                    </label>

                    <p id="connect-consent" class="credential-consent">
                        By connecting intervals.icu, you explicitly consent to the processing of the
                        health-related training and wellness data described in the
                        <a href="/privacy">Privacy Notice</a> for personalized coaching.
                    </p>

                    @if (Session.State == CoachConnectionState.Error && !string.IsNullOrEmpty(Session.ErrorMessage))
                    {
                        <p class="error" role="alert">@DisplayConnectionError</p>
                    }

                    <button class="connect coach-button-orange"
                            aria-describedby="connect-consent"
                            disabled="@(!CanSubmit)"
                            @onclick="ConnectAsync">
                        @if (IsBusy)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                            <span>Connecting...</span>
                        }
                        else
                        {
                            <span>Connect</span>
                        }
                    </button>

                    @if (_showCredentialHelp)
                    {
                        <div class="credential-help-overlay" @onclick="CloseCredentialHelp">
                            <div id="credential-help-modal"
                                 class="credential-help-modal"
                                 role="dialog"
                                 aria-modal="true"
                                 aria-labelledby="credential-help-title"
                                 @onclick:stopPropagation="true">
                                <div class="credential-help-header">
                                    <h3 id="credential-help-title">Where to find Athlete ID and API Key</h3>
                                    <button type="button"
                                            class="credential-help-close"
                                            aria-label="Close help"
                                            @onclick="CloseCredentialHelp">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <p class="credential-help-copy">
                                    Open intervals.icu, go to <strong>Settings</strong>, scroll down, and use
                                    <strong>Developer Settings</strong>.
                                </p>

                                  <img class="credential-help-image"
                                      src="/images/intervals-developer-settings.png"
                                     alt="Screenshot of intervals.icu Settings page with Developer Settings section" />
                            </div>
                        </div>
                    }
                </div>
            }
        </CardContent>
    </SfCard>

    <section class="coach-section">
        @if (_expandedCard is null)
        {
            <div class="coach-prompt-grid">
                @foreach (var prompt in PromptCards)
                {
                    var cardState = GetAssessCardState(prompt.CardType);

                    <SfCard CssClass="coach-prompt-card">
                        <CardContent>
                            <div class="coach-prompt-content">
                                <div class="coach-prompt-heading">
                                    <div class="coach-prompt-icon" aria-hidden="true">
                                        <i class="@prompt.IconClass"></i>
                                    </div>
                                    <h3 class="coach-prompt-title">@prompt.Title</h3>
                                </div>
                                <p class="coach-prompt-description mb-0">@prompt.Description</p>

                                @if (cardState.TotalTokens is not null)
                                {
                                    <p class="coach-token-hint mb-0">Token usage: @cardState.TotalTokens.Value.ToString("N0")</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(cardState.ErrorMessage))
                                {
                                    <p class="@GetErrorCssClass(cardState.ErrorMessage)" role="alert">@cardState.ErrorMessage</p>
                                }
                            </div>
                        </CardContent>
                        <CardFooter>
                            <CardFooterContent>
                                <SfButton CssClass="e-btn coach-outline-button coach-button-orange"
                                          Disabled="@IsAssessButtonDisabled(prompt.CardType)"
                                          @onclick="() => HandleAssessButtonAsync(prompt.CardType)">
                                    @if (cardState.IsLoading)
                                    {
                                        <span class="coach-assess-spinner" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span>@GetAssessButtonText(prompt.CardType)</span>
                                        <span aria-hidden="true">→</span>
                                    }
                                </SfButton>
                            </CardFooterContent>
                        </CardFooter>
                    </SfCard>
                }
            </div>
        }
        else
        {
            var expandedPrompt = GetPromptCard(_expandedCard.Value);
            var expandedState = GetAssessCardState(expandedPrompt.CardType);
            var metricsSnapshot = BuildMetricsSnapshot();
            var fitnessKpis = BuildFitnessKpis();

            <div class="coach-prompt-expanded">
                <SfCard CssClass="coach-prompt-card">
                    <CardContent>
                        <div class="coach-prompt-content">
                            <div class="coach-prompt-heading">
                                <div class="coach-prompt-icon" aria-hidden="true">
                                    <i class="@expandedPrompt.IconClass"></i>
                                </div>
                                <h3 class="coach-prompt-title">@expandedPrompt.Title</h3>
                            </div>
                            <p class="coach-prompt-description mb-0">@expandedPrompt.Description</p>

                            @if (expandedState.TotalTokens is not null)
                            {
                                <p class="coach-token-hint mb-0">Token usage: @expandedState.TotalTokens.Value.ToString("N0")</p>
                            }
                        </div>
                    </CardContent>
                    <CardFooter>
                        <CardFooterContent>
                            <SfButton CssClass="e-btn coach-outline-button coach-button-orange"
                                      Disabled="@IsAssessButtonDisabled(expandedPrompt.CardType)"
                                      @onclick="() => HandleAssessButtonAsync(expandedPrompt.CardType)">
                                <span>@GetAssessButtonText(expandedPrompt.CardType)</span>
                                <span aria-hidden="true">→</span>
                            </SfButton>
                        </CardFooterContent>
                    </CardFooter>
                </SfCard>

                @if (!string.IsNullOrWhiteSpace(expandedState.ResultText))
                {
                    <div class="coach-assess-result-block">
                        @if (metricsSnapshot.Count > 0)
                        {
                            <MetricsSnapshot Items="metricsSnapshot"
                                             FitnessKpis="fitnessKpis" />
                        }

                        <div class="coach-assess-result-actions">
                            <div class="coach-assess-badge" role="note">
                                <span class="coach-assess-badge-icon">✦</span>
                                <span>AI Coach assessment</span>
                            </div>

                            <button type="button"
                                    class="coach-assess-copy"
                                    title="Copy Markdown"
                                    aria-label="Copy Markdown"
                                    @onclick="() => CopyAssessResultAsync(expandedPrompt.CardType)">
                                <i class="bi bi-clipboard"></i>
                            </button>

                            @if (!string.IsNullOrWhiteSpace(expandedState.CopyFeedback))
                            {
                                <span class="coach-assess-copy-feedback">@expandedState.CopyFeedback</span>
                            }
                        </div>

                        <div class="coach-assess-result-markdown">@RenderAssessMarkdown(expandedState.ResultText)</div>

                        @if (!string.IsNullOrWhiteSpace(expandedState.ResponseId))
                        {
                            <FeedbackWidget RequestType="@GetFeedbackRequestType(expandedPrompt.CardType)"
                                            ResponseId="@expandedState.ResponseId"
                                            @key="expandedState.ResponseId" />
                        }
                    </div>
                }
            </div>
        }
    </section>

    <SfCard CssClass="coach-plan-card">
        <CardContent>
            <div class="coach-plan-layout">
                <div class="coach-plan-copy">
                    <div class="coach-plan-label">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Create Plan</span>
                    </div>
                    <p class="coach-plan-description mb-0">
                        Structured plan according to
                        <a href="https://github.com/rbrands/intervals-icu-sync/tree/main/coach-logic"
                           target="_blank"
                           rel="noopener noreferrer">coach logic</a>.
                        Automatic scope: Monday to Wednesday creates the plan for the current week, Thursday to Sunday creates the plan for the next week.
                    </p>

                    @if (_planTotalTokens is not null)
                    {
                        <p class="coach-token-hint coach-token-hint--plan mb-0">Token usage: @_planTotalTokens.Value.ToString("N0")</p>
                    }
                </div>

                <label class="field coach-plan-preference">
                    <span>Scheduling preference (optional)</span>
                    <input type="text"
                           autocomplete="off"
                           maxlength="150"
                           placeholder='e.g. "VO2max session on Tuesday"'
                           disabled="@(IsActionBusy || HasCreatedPlanResult)"
                           @bind="_planSchedulingPreference"
                           @bind:event="oninput" />
                    <div class="d-flex justify-content-end mt-1">
                        <small class="text-muted">@($"{_planSchedulingPreference.Length}/150")</small>
                    </div>
                </label>

                <div class="coach-plan-actions">
                    @if (HasPlanResult && !string.IsNullOrWhiteSpace(_planUploadJson))
                    {
                        <SfButton CssClass="e-btn coach-outline-button coach-button-orange"
                                  Disabled="@(!CanUploadPlan)"
                                  @onclick="UploadPlanAsync">
                            @if (_isPlanUploadInFlight)
                            {
                                <span class="coach-assess-spinner" aria-hidden="true"></span>
                                <span>Uploading...</span>
                            }
                            else if (_planUploaded)
                            {
                                <span>Uploaded</span>
                            }
                            else
                            {
                                <span>Upload Plan</span>
                            }
                        </SfButton>
                    }

                    <SfButton CssClass="e-btn coach-primary-button"
                              Disabled="@(!CanUsePlanButton)"
                              @onclick="HandlePlanButtonAsync">
                        @if (_isPlanRequestInFlight)
                        {
                            <span class="coach-assess-spinner" aria-hidden="true"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>@GetPlanButtonText()</span>
                            <span aria-hidden="true">→</span>
                        }
                    </SfButton>
                </div>
            </div>
        </CardContent>
    </SfCard>

    @if (!string.IsNullOrWhiteSpace(_planUploadFeedback))
    {
        <p class="coach-overview-empty mt-2">@_planUploadFeedback</p>
    }

    @if (_isPlanExpanded &&
         (!string.IsNullOrWhiteSpace(_planErrorMessage) ||
          !string.IsNullOrWhiteSpace(_planReadableText) ||
          !string.IsNullOrWhiteSpace(_planUploadJson)))
    {
        <section class="coach-section">
            <h2 class="coach-section-title">Plan Result</h2>

            <SfCard CssClass="coach-prompt-card">
                <CardContent>
                    @if (!string.IsNullOrWhiteSpace(_planErrorMessage))
                    {
                        <p class="@GetErrorCssClass(_planErrorMessage)" role="alert">@_planErrorMessage</p>
                    }

                    <div class="coach-custom-tabs">
                        <div class="coach-custom-tabs-header" role="tablist" aria-label="Plan result tabs">
                            <button type="button"
                                    id="coach-plan-tab-0"
                                    class="coach-custom-tab @(IsPlanTabSelected(0) ? "is-active" : string.Empty)"
                                    role="tab"
                                    aria-selected="@IsPlanTabSelected(0)"
                                    aria-controls="coach-plan-panel-0"
                                    tabindex="@(IsPlanTabSelected(0) ? 0 : -1)"
                                    @onclick="() => SelectPlanTab(0)">
                                Text
                            </button>

                            <button type="button"
                                    id="coach-plan-tab-1"
                                    class="coach-custom-tab @(IsPlanTabSelected(1) ? "is-active" : string.Empty)"
                                    role="tab"
                                    aria-selected="@IsPlanTabSelected(1)"
                                    aria-controls="coach-plan-panel-1"
                                    tabindex="@(IsPlanTabSelected(1) ? 0 : -1)"
                                    @onclick="() => SelectPlanTab(1)">
                                Weekly Plan
                            </button>

                            <button type="button"
                                    id="coach-plan-tab-2"
                                    class="coach-custom-tab @(IsPlanTabSelected(2) ? "is-active" : string.Empty)"
                                    role="tab"
                                    aria-selected="@IsPlanTabSelected(2)"
                                    aria-controls="coach-plan-panel-2"
                                    tabindex="@(IsPlanTabSelected(2) ? 0 : -1)"
                                    @onclick="() => SelectPlanTab(2)">
                                JSON
                            </button>
                        </div>

                        <div id="coach-plan-panel-0"
                             class="coach-custom-tab-panel"
                             role="tabpanel"
                             aria-labelledby="coach-plan-tab-0"
                             hidden="@(!IsPlanTabSelected(0))">
                            @if (!string.IsNullOrWhiteSpace(_planReadableText))
                            {
                                <div class="coach-assess-result-markdown">@RenderAssessMarkdown(_planReadableText)</div>
                            }
                            else
                            {
                                <p class="coach-overview-empty">No text available.</p>
                            }
                        </div>

                        <div id="coach-plan-panel-1"
                             class="coach-custom-tab-panel"
                             role="tabpanel"
                             aria-labelledby="coach-plan-tab-1"
                             hidden="@(!IsPlanTabSelected(1))">
                            @if (_planWorkouts.Count > 0)
                            {
                                <div class="coach-plan-week-editor">
                                    @foreach (var workout in _planWorkouts)
                                    {
                                        var hasConflict = HasPlanWorkoutDateConflict(workout);

                                        <div class="coach-plan-week-row @(hasConflict ? "is-conflict" : string.Empty)">
                                            <div class="coach-plan-week-main">
                                                <div class="coach-plan-week-title-row">
                                                    <h3 class="coach-plan-week-name">@workout.Name</h3>

                                                    @if (hasConflict)
                                                    {
                                                        <span class="coach-plan-week-warning" title="Multiple workouts are assigned to this day.">
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                            <span>Same day</span>
                                                        </span>
                                                    }
                                                </div>

                                                <div class="coach-plan-week-meta">
                                                    @if (workout.DurationMinutes is not null)
                                                    {
                                                        <span class="coach-plan-week-duration">@workout.DurationMinutes min</span>
                                                    }

                                                    @foreach (var tag in workout.Tags)
                                                    {
                                                        <span class="coach-plan-week-tag">@tag</span>
                                                    }
                                                </div>
                                            </div>

                                            <label class="coach-plan-week-select-wrap">
                                                <span class="coach-plan-week-select-label">Day</span>
                                                <select class="coach-plan-week-select"
                                                        value="@FormatPlanWorkoutDateValue(workout.Date)"
                                                        @onchange="args => OnPlanWorkoutDateChanged(args, workout.Id)">
                                                    @foreach (var option in _planWeekDayOptions)
                                                    {
                                                        <option value="@option.Value">@option.Label</option>
                                                    }
                                                </select>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="coach-overview-empty">No weekly plan available.</p>
                            }
                        </div>

                        <div id="coach-plan-panel-2"
                             class="coach-custom-tab-panel"
                             role="tabpanel"
                             aria-labelledby="coach-plan-tab-2"
                             hidden="@(!IsPlanTabSelected(2))">
                            @if (!string.IsNullOrWhiteSpace(_planUploadJson))
                            {
                                <div class="coach-assess-result-actions">
                                    <button type="button"
                                            class="coach-assess-copy"
                                            title="Copy Upload JSON"
                                            aria-label="Copy Upload JSON"
                                            @onclick="CopyPlanUploadJsonAsync">
                                        <i class="bi bi-clipboard"></i>
                                    </button>

                                    @if (!string.IsNullOrWhiteSpace(_planCopyFeedback))
                                    {
                                        <span class="coach-assess-copy-feedback">@_planCopyFeedback</span>
                                    }
                                </div>

                                <div class="coach-json-viewer">
                                    @RenderFormattedJson(_planUploadJson)
                                </div>
                            }
                            else
                            {
                                <p class="coach-overview-empty">No JSON available.</p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_planResponseId)
                         && (!string.IsNullOrWhiteSpace(_planReadableText) || !string.IsNullOrWhiteSpace(_planUploadJson)))
                    {
                        <div class="mt-2">
                            <FeedbackWidget RequestType="plan"
                                            ResponseId="@_planResponseId"
                                            @key="_planResponseId" />
                        </div>
                    }
                </CardContent>
            </SfCard>
        </section>
    }

    @if (_showDataView)
    {
        <div class="data-view-overlay" @onclick="CloseDataView">
            <div class="data-view-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="data-view-title"
                 @onclick:stopPropagation="true">
                <div class="data-view-header">
                    <h3 id="data-view-title">Athlete Data JSON</h3>
                    <button type="button"
                            class="data-view-close"
                            aria-label="Close data view"
                            @onclick="CloseDataView">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="data-view-meta">
                    <span><strong>Method:</strong> @DataMethodName</span>
                    @if (Session.LastSynced is not null)
                    {
                        <span><strong>Last synced:</strong> @Session.LastSynced.Value.ToLocalTime().ToString("g")</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_dataViewFeedback))
                {
                    <p class="data-view-feedback">@_dataViewFeedback</p>
                }

                <div class="data-view-actions">
                    <button type="button" class="connect" @onclick="CopyJsonAsync">Copy JSON</button>
                    <button type="button" class="coach-inline-link" @onclick="DownloadJsonAsync">Download JSON</button>
                </div>

                <div class="coach-custom-tabs coach-custom-tabs--compact">
                    <div class="coach-custom-tabs-header" role="tablist" aria-label="Athlete data tabs">
                        <button type="button"
                                id="coach-data-tab-0"
                                class="coach-custom-tab @(IsDataViewTabSelected(0) ? "is-active" : string.Empty)"
                                role="tab"
                                aria-selected="@IsDataViewTabSelected(0)"
                                aria-controls="coach-data-panel-0"
                                tabindex="@(IsDataViewTabSelected(0) ? 0 : -1)"
                                @onclick="() => SelectDataViewTab(0)">
                            Overview
                        </button>

                        <button type="button"
                                id="coach-data-tab-1"
                                class="coach-custom-tab @(IsDataViewTabSelected(1) ? "is-active" : string.Empty)"
                                role="tab"
                                aria-selected="@IsDataViewTabSelected(1)"
                                aria-controls="coach-data-panel-1"
                                tabindex="@(IsDataViewTabSelected(1) ? 0 : -1)"
                                @onclick="() => SelectDataViewTab(1)">
                            Parsed JSON
                        </button>

                        <button type="button"
                                id="coach-data-tab-2"
                                class="coach-custom-tab @(IsDataViewTabSelected(2) ? "is-active" : string.Empty)"
                                role="tab"
                                aria-selected="@IsDataViewTabSelected(2)"
                                aria-controls="coach-data-panel-2"
                                tabindex="@(IsDataViewTabSelected(2) ? 0 : -1)"
                                @onclick="() => SelectDataViewTab(2)">
                            Raw JSON
                        </button>
                    </div>

                    <div id="coach-data-panel-0"
                         class="coach-custom-tab-panel"
                         role="tabpanel"
                         aria-labelledby="coach-data-tab-0"
                         hidden="@(!IsDataViewTabSelected(0))">
                        <div class="coach-overview-metrics">
                            @if (OverviewSections.Count == 0)
                            {
                                <p class="coach-overview-empty">No parsed JSON data available.</p>
                            }
                            else
                            {
                                <div class="coach-overview-sections">
                                    @foreach (var overviewSection in OverviewSections)
