    private static PlanningScope ResolvePlanningScope()
    {
        return DateTime.Now.DayOfWeek switch
        {
            DayOfWeek.Monday => PlanningScope.CurrentWeek,
            DayOfWeek.Tuesday => PlanningScope.CurrentWeek,
            DayOfWeek.Wednesday => PlanningScope.CurrentWeek,
            _ => PlanningScope.NextWeek
        };
    }

    private static string NormalizeCoachResponse(string rawBody)
    {
        if (string.IsNullOrWhiteSpace(rawBody))
        {
            return string.Empty;
        }

        try
        {
            using var document = JsonDocument.Parse(rawBody);
            if (document.RootElement.ValueKind == JsonValueKind.String)
            {
                return document.RootElement.GetString() ?? string.Empty;
            }
        }
        catch (JsonException)
        {
            // Keep original response body if it's not JSON-encoded text.
        }

        return rawBody;
    }

    private static (string PlanText, string UploadJson) SplitPlanAndUploadJson(string responseText)
    {
        const string beginMarker = "BEGIN_UPLOAD_JSON";
        const string endMarker = "END_UPLOAD_JSON";

        if (string.IsNullOrWhiteSpace(responseText))
        {
            return (string.Empty, string.Empty);
        }

        var beginIndex = responseText.IndexOf(beginMarker, StringComparison.Ordinal);
        var endIndex = responseText.IndexOf(endMarker, StringComparison.Ordinal);

        if (beginIndex < 0 || endIndex < 0 || endIndex <= beginIndex)
        {
            return (responseText.Trim(), string.Empty);
        }

        var planText = responseText[..beginIndex].Trim();
        var markedSection = responseText[(beginIndex + beginMarker.Length)..endIndex].Trim();
        var uploadJson = ExtractJsonFromMarkedSection(markedSection);

        return (planText, uploadJson);
    }

    private static string ExtractJsonFromMarkedSection(string markedSection)
    {
        if (string.IsNullOrWhiteSpace(markedSection))
        {
            return string.Empty;
        }

        var fencedMatch = Regex.Match(
            markedSection,
            @"```json\s*(?<json>\{[\s\S]*\})\s*```",
            RegexOptions.IgnoreCase);

        if (fencedMatch.Success)
        {
            return fencedMatch.Groups["json"].Value.Trim();
        }

        try
        {
            using var document = JsonDocument.Parse(markedSection);
            return document.RootElement.GetRawText();
        }
        catch (JsonException)
        {
            // Fall through to brace-based extraction for mixed text responses.
        }

        var startBrace = markedSection.IndexOf('{');
        var endBrace = markedSection.LastIndexOf('}');

        if (startBrace >= 0 && endBrace > startBrace)
        {
            return markedSection[startBrace..(endBrace + 1)].Trim();
        }

        return markedSection.Trim();
    }

    private static MarkupString RenderFormattedJson(string? json, bool includeLineNumbers = true)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return new MarkupString(string.Empty);
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            var formattedJson = JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            return new MarkupString(RenderJsonWithLineNumbers(formattedJson, includeLineNumbers));
        }
        catch (JsonException)
        {
            return new MarkupString($"<div class=\"coach-json-line coach-json-line--error\">{System.Net.WebUtility.HtmlEncode(json)}</div>");
        }
    }

    private static string RenderJsonWithLineNumbers(string json, bool includeLineNumbers)
    {
        var lines = json.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var builder = new System.Text.StringBuilder();

        for (var index = 0; index < lines.Length; index++)
        {
            builder.Append(includeLineNumbers
                ? "<div class=\"coach-json-line\"><span class=\"coach-json-line-number\">"
                : "<div class=\"coach-json-line coach-json-line--compact\"><span class=\"coach-json-line-text\">");

            if (includeLineNumbers)
            {
                builder.Append((index + 1).ToString("D2"));
                builder.Append("</span><span class=\"coach-json-line-text\">");
            }

            builder.Append(HighlightJsonLine(lines[index]));
            builder.Append("</span></div>");
        }

        return builder.ToString();
    }

    private static string HighlightJsonLine(string line)
    {
        var encodedLine = System.Net.WebUtility.HtmlEncode(line);

        if (string.IsNullOrWhiteSpace(encodedLine))
        {
            return string.Empty;
        }

        var keyMatch = Regex.Match(encodedLine, @"^(\s*)(\&quot;.*?\&quot;)(\s*:\s*)(.*)$");
        if (keyMatch.Success)
        {
            return string.Concat(
                keyMatch.Groups[1].Value,
                "<span class=\"coach-json-key\">",
                keyMatch.Groups[2].Value,
                "</span>",
                keyMatch.Groups[3].Value,
                HighlightJsonValue(keyMatch.Groups[4].Value));
        }

        return HighlightJsonValue(encodedLine);
    }

    private static string HighlightJsonValue(string encodedText)
    {
        if (string.IsNullOrWhiteSpace(encodedText))
        {
            return string.Empty;
        }

        var trimmed = encodedText.Trim();

        if (Regex.IsMatch(trimmed, @"^&quot;.*&quot;[,]?$"))
        {
            return $"<span class=\"coach-json-string\">{encodedText}</span>";
        }

        if (Regex.IsMatch(trimmed, @"^(true|false)$", RegexOptions.IgnoreCase))
        {
            return $"<span class=\"coach-json-boolean\">{encodedText}</span>";
        }

        if (trimmed.Equals("null", StringComparison.OrdinalIgnoreCase))
        {
            return $"<span class=\"coach-json-null\">{encodedText}</span>";
        }

        if (Regex.IsMatch(trimmed, @"^-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?[,]?$"))
        {
            return $"<span class=\"coach-json-number\">{encodedText}</span>";
        }

        return encodedText;
    }

