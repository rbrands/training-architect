@page "/coach"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IAthleteSession Session
@inject ICredentialStore CredentialStore
@inject IJSRuntime JS
@inject HttpClient Http
@using Markdig
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@using TrainingArchitect.Core.Constants
@using TrainingArchitect.Core.Models
@implements IDisposable


<PageTitle>AI Coach · Training Architect</PageTitle>

<div class="coach-page">
    <header class="coach-page-header">
        <h1 class="fw-bold mb-2">AI Coach</h1>
        <p class="coach-page-subtitle mb-0">
            Understand your current state and start with the most useful coaching entry points.
        </p>
    </header>

    <SfCard CssClass="coach-status-card">
        <CardContent>
            <div class="coach-status-layout">
                <div class="coach-status-copy">
                    <div class="coach-status-topline @StatusCssClass">
                        <span class="coach-status-badge" aria-hidden="true">
                            <i class="bi @StatusIconClass"></i>
                        </span>
                        <span class="coach-status-title">@StatusText@AthleteSuffix</span>
                    </div>
                    @if (ShowRememberedNote)
                    {
                        <div class="coach-status-note">
                            <i class="bi bi-key"></i>
                            <span>API key remembered on this device</span>
                        </div>
                    }
                </div>

                <div class="coach-status-actions">
                    <button type="button"
                            class="coach-inline-link"
                            disabled="@(!CanViewData)"
                            @onclick="OpenDataView">
                        View Data
                    </button>
                    @if (Session.State == CoachConnectionState.Connected)
                    {
                        <button type="button"
                                class="coach-inline-link"
                                @onclick="RefreshAsync"
                                disabled="@(!CanRefresh)">
                            @(Session.IsRefreshing ? "Refreshing..." : "Refresh")
                        </button>

                        <button type="button"
                                class="coach-inline-link coach-inline-link-muted"
                                @onclick="DisconnectAsync"
                                disabled="@IsActionBusy">
                            Disconnect
                        </button>
                    }
                </div>
            </div>

            @if (CanConnect)
            {
                <div class="credential-form">
                    <h2>Connect to intervals.icu</h2>
                    <p class="subtitle subtitle-with-help">
                        <span>Enter your Athlete ID and API key to load your training data.</span>
                        <button type="button"
                                class="credential-help-inline-trigger"
                                title="Show where to find Athlete ID and API Key"
                                aria-label="Show where to find Athlete ID and API Key"
                                aria-expanded="@_showCredentialHelp"
                                aria-controls="credential-help-modal"
                                @onclick="ToggleCredentialHelp">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>Where to find these values</span>
                        </button>
                    </p>

                    <label class="field">
                        <span>Athlete ID</span>
                        <input type="text"
                               autocomplete="off"
                               placeholder="e.g. 12345"
                               disabled="@IsBusy"
                               @bind="_athleteId" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>API Key</span>
                        <input type="password"
                               autocomplete="off"
                               placeholder="Your intervals.icu API key"
                               disabled="@IsBusy"
                               @bind="_apiKey" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>Language</span>
                        <select disabled="@IsBusy" @bind="_language">
                            <option value="@CoachLanguage.English">English</option>
                            <option value="@CoachLanguage.German">German</option>
                            <option value="@CoachLanguage.Spanish">Spanish</option>
                            <option value="@CoachLanguage.French">French</option>
                        </select>
                    </label>

                    <label class="field">
                        <span>Athlete Profile Goal</span>
                        <select disabled="@IsBusy" @bind="_profileGoal">
                            <option value="@AthleteProfileGoal.Climber">climber</option>
                            <option value="@AthleteProfileGoal.Criterium">criterium</option>
                            <option value="@AthleteProfileGoal.Marathon">marathon</option>
                            <option value="@AthleteProfileGoal.RoadRace">roadrace</option>
                        </select>
                    </label>

                    <label class="remember">
                        <input type="checkbox" disabled="@IsBusy" @bind="_remember" />
                        <span>Remember on this device</span>
                    </label>

                    @if (Session.State == CoachConnectionState.Error && !string.IsNullOrEmpty(Session.ErrorMessage))
                    {
                        <p class="error" role="alert">@DisplayConnectionError</p>
                    }

                    <button class="connect coach-button-orange" disabled="@(!CanSubmit)" @onclick="ConnectAsync">
                        @if (IsBusy)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                            <span>Connecting...</span>
                        }
                        else
                        {
                            <span>Connect</span>
                        }
                    </button>

                    @if (_showCredentialHelp)
                    {
                        <div class="credential-help-overlay" @onclick="CloseCredentialHelp">
                            <div id="credential-help-modal"
                                 class="credential-help-modal"
                                 role="dialog"
                                 aria-modal="true"
                                 aria-labelledby="credential-help-title"
                                 @onclick:stopPropagation="true">
                                <div class="credential-help-header">
                                    <h3 id="credential-help-title">Where to find Athlete ID and API Key</h3>
                                    <button type="button"
                                            class="credential-help-close"
                                            aria-label="Close help"
                                            @onclick="CloseCredentialHelp">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <p class="credential-help-copy">
                                    Open intervals.icu, go to <strong>Settings</strong>, scroll down, and use
                                    <strong>Developer Settings</strong>.
                                </p>

                                  <img class="credential-help-image"
                                      src="/images/intervals-developer-settings.png"
                                     alt="Screenshot of intervals.icu Settings page with Developer Settings section" />
                            </div>
                        </div>
                    }
                </div>
            }
        </CardContent>
    </SfCard>

    <section class="coach-section">
        <h2 class="coach-section-title">Standard Prompts</h2>

        @if (_expandedCard is null)
        {
            <div class="coach-prompt-grid">
                @foreach (var prompt in PromptCards)
                {
                    var cardState = GetAssessCardState(prompt.CardType);

                    <SfCard CssClass="coach-prompt-card">
                        <CardContent>
                            <div class="coach-prompt-icon" aria-hidden="true">
                                <i class="@prompt.IconClass"></i>
                            </div>
                            <h3 class="coach-prompt-title">@prompt.Title</h3>
                            <p class="coach-prompt-description mb-0">@prompt.Description</p>

                            @if (!string.IsNullOrWhiteSpace(cardState.ErrorMessage))
                            {
                                <p class="coach-assess-error" role="alert">@cardState.ErrorMessage</p>
                            }
                        </CardContent>
                        <CardFooter>
                            <CardFooterContent>
                                <SfButton CssClass="e-btn coach-outline-button coach-button-orange"
                                          Disabled="@IsAssessButtonDisabled(prompt.CardType)"
                                          @onclick="() => HandleAssessButtonAsync(prompt.CardType)">
                                    @if (cardState.IsLoading)
                                    {
                                        <span class="coach-assess-spinner" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span>@GetAssessButtonText(prompt.CardType)</span>
                                        <span aria-hidden="true">→</span>
                                    }
                                </SfButton>
                            </CardFooterContent>
                        </CardFooter>
                    </SfCard>
                }
            </div>
        }
        else
        {
            var expandedPrompt = GetPromptCard(_expandedCard.Value);
            var expandedState = GetAssessCardState(expandedPrompt.CardType);

            <div class="coach-prompt-expanded">
                <SfCard CssClass="coach-prompt-card">
                    <CardContent>
                        <div class="coach-prompt-icon" aria-hidden="true">
                            <i class="@expandedPrompt.IconClass"></i>
                        </div>
                        <h3 class="coach-prompt-title">@expandedPrompt.Title</h3>
                        <p class="coach-prompt-description mb-0">@expandedPrompt.Description</p>
                    </CardContent>
                    <CardFooter>
                        <CardFooterContent>
                            <SfButton CssClass="e-btn coach-outline-button coach-button-orange"
                                      Disabled="@IsAssessButtonDisabled(expandedPrompt.CardType)"
                                      @onclick="() => HandleAssessButtonAsync(expandedPrompt.CardType)">
                                <span>@GetAssessButtonText(expandedPrompt.CardType)</span>
                                <span aria-hidden="true">→</span>
                            </SfButton>
                        </CardFooterContent>
                    </CardFooter>
                </SfCard>

                @if (!string.IsNullOrWhiteSpace(expandedState.ResultText))
                {
                    <div class="coach-assess-result-block">
                        <div class="coach-assess-result-actions">
                            <button type="button"
                                    class="coach-assess-copy"
                                    title="Copy Markdown"
                                    aria-label="Copy Markdown"
                                    @onclick="() => CopyAssessResultAsync(expandedPrompt.CardType)">
                                <i class="bi bi-clipboard"></i>
                            </button>

                            @if (!string.IsNullOrWhiteSpace(expandedState.CopyFeedback))
                            {
                                <span class="coach-assess-copy-feedback">@expandedState.CopyFeedback</span>
                            }
                        </div>

                        <div class="coach-assess-result-markdown">@RenderAssessMarkdown(expandedState.ResultText)</div>
                    </div>
                }
            </div>
        }
    </section>

    <SfCard CssClass="coach-plan-card">
        <CardContent>
            <div class="coach-plan-layout">
                <div class="coach-plan-copy">
                    <div class="coach-plan-label">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Create Plan</span>
                    </div>
                    <p class="coach-plan-description mb-0">
                        Structured plan based on Friel/Coggan. Confirmation before upload.
                    </p>
                </div>

                <SfButton CssClass="e-btn coach-primary-button" Disabled="@(!CanUseCoachActions)">
                    <span>Create Plan</span>
                    <span aria-hidden="true">→</span>
                </SfButton>
            </div>
        </CardContent>
    </SfCard>

    @if (_showDataView)
    {
        <div class="data-view-overlay" @onclick="CloseDataView">
            <div class="data-view-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="data-view-title"
                 @onclick:stopPropagation="true">
                <div class="data-view-header">
                    <h3 id="data-view-title">Athlete Data JSON</h3>
                    <button type="button"
                            class="data-view-close"
                            aria-label="Close data view"
                            @onclick="CloseDataView">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="data-view-meta">
                    <span><strong>Method:</strong> @DataMethodName</span>
                    @if (Session.LastSynced is not null)
                    {
                        <span><strong>Last synced:</strong> @Session.LastSynced.Value.ToLocalTime().ToString("g")</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_dataViewFeedback))
                {
                    <p class="data-view-feedback">@_dataViewFeedback</p>
                }

                <div class="data-view-actions">
                    <button type="button" class="connect" @onclick="CopyJsonAsync">Copy JSON</button>
                    <button type="button" class="coach-inline-link" @onclick="DownloadJsonAsync">Download JSON</button>
                </div>

                <SfTab CssClass="coach-data-tabs">
                    <TabItems>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Overview"></TabHeader>
                            </ChildContent>
                            <ContentTemplate>
                                <div class="coach-overview-metrics">
                                    @if (OverviewSections.Count == 0)
                                    {
                                        <p class="coach-overview-empty">No parsed JSON data available.</p>
                                    }
                                    else
                                    {
                                        <div class="coach-overview-sections">
                                            @foreach (var section in OverviewSections)
                                            {
                                                <details class="coach-overview-section" open="@section.IsInitiallyOpen">
                                                    <summary class="coach-overview-section-summary">
                                                        <span class="coach-overview-section-title">@section.Title</span>
                                                        <span class="coach-overview-section-meta">@section.Summary</span>
                                                    </summary>
                                                    <pre class="coach-overview-section-json">@section.PrettyJson</pre>
                                                </details>
                                            }
                                        </div>
                                    }
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Parsed JSON"></TabHeader>
                            </ChildContent>
                            <ContentTemplate>
                                <pre class="data-view-json">@DataParsedPrettyJson</pre>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Raw JSON"></TabHeader>
                            </ChildContent>
                            <ContentTemplate>
                                <pre class="data-view-json">@DataRawPrettyJson</pre>
                            </ContentTemplate>
                        </TabItem>
                    </TabItems>
                </SfTab>
            </div>
        </div>
    }
</div>

@code {
    private enum AssessCardType
    {
        MetricsWellness,
        LastTraining,
        Week
    }

    private sealed class AssessCardState
    {
        public string? ResultText { get; set; }
        public bool IsLoading { get; set; }
        public string? ErrorMessage { get; set; }
        public string? CopyFeedback { get; set; }
    }

    private string StatusText => Session.State switch
    {
        CoachConnectionState.Connected => "Connected",
        CoachConnectionState.Connecting => "Connecting",
        CoachConnectionState.Error => "Connection Error",
        _ => "Disconnected"
    };

    private string AthleteSuffix => string.IsNullOrWhiteSpace(Session.AthleteId)
        ? string.Empty
        : $" · Athlete {Session.AthleteId}";

    private string StatusCssClass => Session.State switch
    {
        CoachConnectionState.Connected => "status-connected",
        CoachConnectionState.Connecting => "status-connecting",
        CoachConnectionState.Error => "status-error",
        _ => "status-disconnected"
    };

    private string StatusIconClass => Session.State switch
    {
        CoachConnectionState.Connected => "bi-check-circle",
        CoachConnectionState.Connecting => "bi-arrow-repeat",
        CoachConnectionState.Error => "bi-exclamation-triangle",
        _ => "bi-dash-circle"
    };

    private string DisplayConnectionError => FormatConnectionError(Session.ErrorMessage);

    private bool CanUseCoachActions => Session.State == CoachConnectionState.Connected;
    private bool CanViewData => CanUseCoachActions && (Session.AthleteDataParsed is not null || !string.IsNullOrWhiteSpace(Session.AthleteDataJson));

    private bool _showRememberedHint;
    private bool _showCredentialHelp;
    private bool _showDataView;
    private string _dataViewFeedback = string.Empty;

    private bool ShowRememberedNote => _showRememberedHint;

    private string _athleteId = string.Empty;
    private string _apiKey = string.Empty;
    private CoachLanguage _language = CoachLanguage.English;
    private AthleteProfileGoal _profileGoal = AthleteProfileGoal.RoadRace;
    private bool _remember;
    private readonly Dictionary<AssessCardType, AssessCardState> _assessCardStates = new()
    {
        [AssessCardType.MetricsWellness] = new AssessCardState(),
        [AssessCardType.LastTraining] = new AssessCardState(),
        [AssessCardType.Week] = new AssessCardState()
    };
    private AssessCardType? _expandedCard;
    private bool _isAnyRequestInFlight;

    private bool IsBusy => Session.State == CoachConnectionState.Connecting;
    private bool IsActionBusy => IsBusy || Session.IsRefreshing || _isAnyRequestInFlight;
    private bool CanRefresh => Session.State == CoachConnectionState.Connected && !IsActionBusy;

    private bool CanSubmit => !IsActionBusy
        && !string.IsNullOrWhiteSpace(_athleteId)
        && !string.IsNullOrWhiteSpace(_apiKey);

    private bool CanConnect => Session.State is CoachConnectionState.Disconnected or CoachConnectionState.Error;

    private static readonly IReadOnlyList<PromptCardModel> PromptCards =
    [
        new(AssessCardType.MetricsWellness, "bi bi-speedometer2", "Metrics & Wellness", "Complete view of CTL/ATL/TSB and wellness data."),
        new(AssessCardType.LastTraining, "bi bi-bicycle", "Last Training", "Assessment of the latest workout in context."),
        new(AssessCardType.Week, "bi bi-calendar3", "Week", "Training week summarized and put into context.")
    ];

    private sealed record PromptCardModel(AssessCardType CardType, string IconClass, string Title, string Description);
    private sealed record JsonOverviewSection(string Title, string Summary, string PrettyJson, bool IsInitiallyOpen);

    private static readonly MarkdownPipeline AssessMarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private IReadOnlyList<JsonOverviewSection> OverviewSections => BuildOverviewSections();

    private IReadOnlyList<JsonOverviewSection> BuildOverviewSections()
    {
        var root = GetOverviewRoot();
        if (root is null)
        {
            return [];
        }

        var sections = new List<JsonOverviewSection>();
        var knownSectionKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "metrics",
            "week_summary",
            "activities",
            "fueling_analysis",
            "planned_workouts"
        };

        var headerProperties = new Dictionary<string, JsonElement>(StringComparer.OrdinalIgnoreCase);
        foreach (var property in root.Value.EnumerateObject())
        {
            if (knownSectionKeys.Contains(property.Name))
            {
                continue;
            }

            if (property.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
            {
                continue;
            }

            headerProperties[property.Name] = property.Value;
        }

        if (headerProperties.Count > 0)
        {
            sections.Add(new JsonOverviewSection(
                "Header Data",
                $"{headerProperties.Count} fields",
                SerializePretty(headerProperties),
                IsInitiallyOpen: true));
        }

        AddOverviewSection(sections, root.Value, "metrics", "Metrics", isInitiallyOpen: true);
        AddOverviewSection(sections, root.Value, "week_summary", "Week Summary", isInitiallyOpen: false);
        AddOverviewSection(sections, root.Value, "activities", "Activities", isInitiallyOpen: false);
        AddOverviewSection(sections, root.Value, "fueling_analysis", "Fueling Analysis", isInitiallyOpen: false);
        AddOverviewSection(sections, root.Value, "planned_workouts", "Planned Workouts", isInitiallyOpen: false);

        return sections;
    }

    private JsonElement? GetOverviewRoot()
    {
        var parsed = Session.AthleteDataParsed;
        if (parsed is not null && parsed.Value.ValueKind == JsonValueKind.Object)
        {
            return parsed;
        }

        var fallbackJson = Session.AthleteDataJson;
        if (string.IsNullOrWhiteSpace(fallbackJson))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(fallbackJson);
            var root = document.RootElement.Clone();
            return root.ValueKind == JsonValueKind.Object ? root : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static void AddOverviewSection(
        List<JsonOverviewSection> sections,
        JsonElement root,
        string key,
        string title,
        bool isInitiallyOpen)
    {
        if (!root.TryGetProperty(key, out var value))
        {
            return;
        }

        sections.Add(new JsonOverviewSection(
            title,
            BuildSectionSummary(value),
            SerializePretty(value),
            IsInitiallyOpen: isInitiallyOpen));
    }

    private static string BuildSectionSummary(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.Object => $"{value.EnumerateObject().Count()} fields",
            JsonValueKind.Array => $"{value.GetArrayLength()} items",
            JsonValueKind.String => "text value",
            JsonValueKind.Number => "numeric value",
            JsonValueKind.True or JsonValueKind.False => "boolean value",
            JsonValueKind.Null => "null",
            _ => "value"
        };
    }

    private static string SerializePretty<TValue>(TValue value)
    {
        return JsonSerializer.Serialize(value, new JsonSerializerOptions
        {
            WriteIndented = true
        });
    }

    private static JsonElement? GetObjectProperty(JsonElement? parent, string propertyName)
    {
        var property = GetAnyProperty(parent, propertyName);
        if (property is null || property.Value.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        return property;
    }

    private static JsonElement? GetAnyProperty(JsonElement? parent, string propertyName)
    {
        if (parent is null || parent.Value.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        return parent.Value.TryGetProperty(propertyName, out var value)
            ? value
            : null;
    }

    private static MarkupString RenderAssessMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return new MarkupString(string.Empty);
        }

        var normalized = NormalizeSectionNumbering(markdown);
        return new MarkupString(Markdown.ToHtml(normalized, AssessMarkdownPipeline));
    }

    private static string NormalizeSectionNumbering(string markdown)
    {
        var normalized = markdown.Replace("\r\n", "\n", StringComparison.Ordinal);
        var lines = normalized.Split('\n');
        var sectionCounter = 0;

        for (var index = 0; index < lines.Length; index++)
        {
            var line = lines[index];
            var sectionMatch = Regex.Match(line, @"^\s*\d+\.\s+(.+:)\s*$");
            if (!sectionMatch.Success)
            {
                continue;
            }

            sectionCounter++;
            lines[index] = $"{sectionCounter}. {sectionMatch.Groups[1].Value}";
        }

        return string.Join("\n", lines);
    }

    private string DataParsedPrettyJson
    {
        get
        {
            var parsed = Session.AthleteDataParsed;
            if (parsed is null)
            {
                return string.IsNullOrWhiteSpace(Session.AthleteDataJson) ? "{}" : Session.AthleteDataJson;
            }

            return JsonSerializer.Serialize(parsed.Value, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
    }

    private string DataRawPrettyJson
    {
        get
        {
            var raw = Session.AthleteDataRaw;
            if (string.IsNullOrWhiteSpace(raw))
            {
                return "{}";
            }

            try
            {
                using var document = JsonDocument.Parse(raw);
                return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
            catch (JsonException)
            {
                return raw;
            }
        }
    }

    private string DataMethodName => string.IsNullOrWhiteSpace(Session.AthleteDataMethodName)
        ? "n/a"
        : Session.AthleteDataMethodName;

    private static string FormatConnectionError(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return string.Empty;
        }

        if (TryExtractConnectionError(message, out var conciseMessage))
        {
            return conciseMessage;
        }

        return message.Trim();
    }

    private static bool TryExtractConnectionError(string message, out string conciseMessage)
    {
        conciseMessage = string.Empty;

        try
        {
            using var document = JsonDocument.Parse(message);
            if (!TryFindErrorPayload(document.RootElement, out var payload))
            {
                return false;
            }

            var errorText = GetStringProperty(payload, "error");
            if (string.IsNullOrWhiteSpace(errorText))
            {
                return false;
            }

            var hintText = GetHintText(payload);
            conciseMessage = string.IsNullOrWhiteSpace(hintText)
                ? errorText.Trim()
                : $"{errorText.Trim()} {hintText.Trim()}";
            return true;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private static bool TryFindErrorPayload(JsonElement element, out JsonElement payload)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            if (!string.IsNullOrWhiteSpace(GetStringProperty(element, "error")))
            {
                payload = element;
                return true;
            }

            foreach (var propertyName in new[] { "dataParsed", "result" })
            {
                if (!element.TryGetProperty(propertyName, out var property))
                {
                    continue;
                }

                if (property.ValueKind == JsonValueKind.String)
                {
                    var text = property.GetString();
                    if (!string.IsNullOrWhiteSpace(text))
                    {
                        try
                        {
                            using var nested = JsonDocument.Parse(text);
                            if (TryFindErrorPayload(nested.RootElement, out payload))
                            {
                                return true;
                            }
                        }
                        catch (JsonException)
                        {
                            // Ignore non-JSON strings.
                        }
                    }
                }

                if (property.ValueKind == JsonValueKind.Object && TryFindErrorPayload(property, out payload))
                {
                    return true;
                }
            }
        }

        payload = default;
        return false;
    }

    private static string? GetHintText(JsonElement element)
    {
        var directHint = GetStringProperty(element, "hint");
        if (!string.IsNullOrWhiteSpace(directHint))
        {
            return directHint;
        }

        var logText = GetStringProperty(element, "log");
        if (string.IsNullOrWhiteSpace(logText))
        {
            return null;
        }

        var hintIndex = logText.IndexOf("Hint:", StringComparison.OrdinalIgnoreCase);
        if (hintIndex < 0)
        {
            return null;
        }

        var hintText = logText[(hintIndex + "Hint:".Length)..].Trim();
        return string.IsNullOrWhiteSpace(hintText) ? null : hintText;
    }

    private static string? GetStringProperty(JsonElement element, string propertyName)
    {
        if (element.ValueKind != JsonValueKind.Object ||
            !element.TryGetProperty(propertyName, out var property) ||
            property.ValueKind != JsonValueKind.String)
        {
            return null;
        }

        var value = property.GetString();
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private async Task ConnectAsync()
    {
        if (!CanSubmit)
            return;

        await Session.ConnectAsync(_athleteId.Trim(), _apiKey.Trim(), _language, _profileGoal, _remember);
        InvalidateAssessResults();
        await RefreshRememberedHintAsync();
    }

    private async Task DisconnectAsync()
    {
        if (IsActionBusy)
            return;

        await Session.DisconnectAsync();
        _showDataView = false;
        InvalidateAssessResults();
        await RefreshRememberedHintAsync();
    }

    private async Task RefreshAsync()
    {
        if (!CanRefresh)
            return;

        await Session.RefreshAsync();
        InvalidateAssessResults();
    }

    private AssessCardState GetAssessCardState(AssessCardType cardType) => _assessCardStates[cardType];

    private PromptCardModel GetPromptCard(AssessCardType cardType) =>
        PromptCards.First(card => card.CardType == cardType);

    private string GetAssessButtonText(AssessCardType cardType)
    {
        var state = GetAssessCardState(cardType);

        if (state.ResultText is null)
        {
            return "Assess";
        }

        return _expandedCard == cardType ? "Close" : "Reopen";
    }

    private bool IsAssessButtonDisabled(AssessCardType cardType)
    {
        if (!CanUseCoachActions)
        {
            return true;
        }

        var state = GetAssessCardState(cardType);
        if (state.IsLoading)
        {
            return true;
        }

        if (_isAnyRequestInFlight && state.ResultText is null)
        {
            return true;
        }

        if (_isAnyRequestInFlight && state.ResultText is not null && _expandedCard != cardType)
        {
            return true;
        }

        return false;
    }

    private async Task HandleAssessButtonAsync(AssessCardType cardType)
    {
        if (!CanUseCoachActions)
        {
            return;
        }

        var state = GetAssessCardState(cardType);

        if (state.ResultText is null)
        {
            await ExecuteAssessRequestAsync(cardType);
            return;
        }

        if (_expandedCard == cardType)
        {
            _expandedCard = null;
            return;
        }

        if (_isAnyRequestInFlight)
        {
            return;
        }

        _expandedCard = cardType;
    }

    private async Task ExecuteAssessRequestAsync(AssessCardType cardType)
    {
        if (_isAnyRequestInFlight)
        {
            return;
        }

        var state = GetAssessCardState(cardType);
        state.IsLoading = true;
        state.ErrorMessage = null;
        _isAnyRequestInFlight = true;
        StateHasChanged();

        try
        {
            var request = BuildAssessRequest(cardType);

            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, "/api/coach/assess")
            {
                Content = JsonContent.Create(request)
            };

            AppendCredentialHeaders(httpRequest);

            using var response = await Http.SendAsync(httpRequest);

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                state.ErrorMessage = string.IsNullOrWhiteSpace(errorBody)
                    ? "Assess request failed. Please try again."
                    : $"Assess request failed: {errorBody}";
                return;
            }

            var assessResponse = await response.Content.ReadFromJsonAsync<AssessResponse>();
            if (assessResponse is null)
            {
                state.ErrorMessage = "Assess request returned no content.";
                return;
            }

            state.ResultText = assessResponse.Content;
            state.ErrorMessage = null;
            _expandedCard = cardType;
        }
        catch
        {
            state.ErrorMessage = "Assess request failed. Please try again.";
        }
        finally
        {
            state.IsLoading = false;
            _isAnyRequestInFlight = _assessCardStates.Values.Any(card => card.IsLoading);
        }
    }

    private AssessRequest BuildAssessRequest(AssessCardType cardType)
    {
        var weekDataJson = Session.AthleteDataJson;

        return new AssessRequest(
            weekDataJson ?? "{}",
            GetDisciplineType(),
            GetResponseLanguage(),
            ToAssessmentType(cardType));
    }

    private string GetDisciplineType()
    {
        var source = Session.ProfileGoal ?? _profileGoal;
        return source.ToString().ToLowerInvariant();
    }

    private string GetResponseLanguage()
    {
        var source = Session.Language ?? _language;
        return source.ToString();
    }

    private static AssessmentType ToAssessmentType(AssessCardType cardType) => cardType switch
    {
        AssessCardType.MetricsWellness => AssessmentType.Metrics,
        AssessCardType.LastTraining => AssessmentType.Activity,
        AssessCardType.Week => AssessmentType.Week,
        _ => AssessmentType.Metrics
    };

    private void AppendCredentialHeaders(HttpRequestMessage request)
    {
        var hasActiveCredentials = Session.TryGetActiveCredentials(out var activeAthleteId, out var activeApiKey);
        var athleteId = hasActiveCredentials
            ? activeAthleteId
            : (string.IsNullOrWhiteSpace(Session.AthleteId) ? _athleteId : Session.AthleteId);
        var apiKey = hasActiveCredentials ? activeApiKey : _apiKey;

        if (!string.IsNullOrWhiteSpace(athleteId))
        {
            request.Headers.TryAddWithoutValidation(IntervalsHeaders.AthleteId, athleteId);
        }

        if (!string.IsNullOrWhiteSpace(apiKey))
        {
            request.Headers.TryAddWithoutValidation(IntervalsHeaders.ApiKey, apiKey);
        }
    }

    private void InvalidateAssessResults()
    {
        foreach (var cardState in _assessCardStates.Values)
        {
            cardState.ResultText = null;
            cardState.IsLoading = false;
            cardState.ErrorMessage = null;
            cardState.CopyFeedback = null;
        }

        _expandedCard = null;
        _isAnyRequestInFlight = false;
    }

    private async Task CopyAssessResultAsync(AssessCardType cardType)
    {
        var state = GetAssessCardState(cardType);
        if (string.IsNullOrWhiteSpace(state.ResultText))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("trainingArchitect.copyText", state.ResultText);
            state.CopyFeedback = "Copied";
        }
        catch
        {
            state.CopyFeedback = "Copy failed";
        }

        StateHasChanged();

        await Task.Delay(1800);
        if (state.CopyFeedback is not null)
        {
            state.CopyFeedback = null;
            StateHasChanged();
        }
    }

    private void OpenDataView()
    {
        if (!CanViewData)
            return;

        _dataViewFeedback = string.Empty;
        _showDataView = true;
    }

    private void CloseDataView()
    {
        _showDataView = false;
        _dataViewFeedback = string.Empty;
    }

    private async Task CopyJsonAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("trainingArchitect.copyText", DataParsedPrettyJson);
            _dataViewFeedback = "JSON copied to clipboard.";
        }
        catch
        {
            _dataViewFeedback = "Copy failed. Please copy manually from the JSON panel.";
        }
    }

    private async Task DownloadJsonAsync()
    {
        var fileName = BuildCoachInputFileName();

        await JS.InvokeVoidAsync("trainingArchitect.downloadText", fileName, DataParsedPrettyJson);
        _dataViewFeedback = "JSON file download started.";
    }

    private string BuildCoachInputFileName()
    {
        var parsed = Session.AthleteDataParsed;
        if (parsed is not null
            && parsed.Value.ValueKind == JsonValueKind.Object
            && parsed.Value.TryGetProperty("week_starting", out var weekStarting)
            && weekStarting.ValueKind == JsonValueKind.String)
        {
            var weekStartingText = weekStarting.GetString();
            if (DateOnly.TryParse(weekStartingText, out var weekStartingDate))
            {
                return $"coach_input_{weekStartingDate:yyyy-MM-dd}.json";
            }
        }

        return $"coach_input_{DateTime.UtcNow:yyyy-MM-dd}.json";
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;

        var loaded = await CredentialStore.LoadAsync();
        if (loaded is not null)
        {
            _athleteId = loaded.Credential.AthleteId;
            _apiKey = loaded.Credential.ApiKey;
            _language = loaded.Credential.Language;
            _profileGoal = loaded.Credential.ProfileGoal;
            _remember = loaded.Durability == CredentialDurability.Persistent;
        }

        await RefreshRememberedHintAsync();
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshRememberedHintAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshRememberedHintAsync()
    {
        var loaded = await CredentialStore.LoadAsync();

        _showRememberedHint =
            loaded is not null
            && loaded.Durability == CredentialDurability.Persistent
            && !string.IsNullOrWhiteSpace(loaded.Credential.ApiKey)
            && (string.IsNullOrWhiteSpace(Session.AthleteId)
                || string.Equals(loaded.Credential.AthleteId, Session.AthleteId, StringComparison.Ordinal));
    }

    private void ToggleCredentialHelp()
    {
        _showCredentialHelp = !_showCredentialHelp;
    }

    private void CloseCredentialHelp()
    {
        _showCredentialHelp = false;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
