    private async Task ExecuteAssessRequestAsync(AssessCardType cardType)
    {
        if (IsAnyRequestInFlight)
        {
            return;
        }

        var state = GetAssessCardState(cardType);
        state.IsLoading = true;
        state.ErrorMessage = null;
        _isAssessRequestInFlight = true;
        StateHasChanged();

        try
        {
            var request = BuildAssessRequest(cardType);

            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, "/api/coach/assess")
            {
                Content = JsonContent.Create(request)
            };

            AppendCredentialHeaders(httpRequest);

            using var response = await Http.SendAsync(httpRequest);

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                state.ErrorMessage = FormatRequestError("Assess", errorBody);
                return;
            }

            var assessResponse = await response.Content.ReadFromJsonAsync<AssessResponse>();
            if (assessResponse is null)
            {
                state.ErrorMessage = "Assess request returned no content.";
                return;
            }

            state.ResultText = assessResponse.Content;
            state.TotalTokens = assessResponse.TotalTokens;
            state.ResponseId = assessResponse.ResponseId;
            state.ErrorMessage = null;
            _expandedCard = cardType;
        }
        catch
        {
            state.ErrorMessage = "Assess request failed. Please try again.";
        }
        finally
        {
            state.IsLoading = false;
            _isAssessRequestInFlight = _assessCardStates.Values.Any(card => card.IsLoading);
        }
    }

    private async Task CreatePlanAsync()
    {
        if (!CanUsePlanButton)
        {
            return;
        }

        _isPlanRequestInFlight = true;
        _planUploaded = false;
        _planUploadFeedback = null;
        _planErrorMessage = null;
        _planReadableText = null;
        _planUploadJson = null;
        _planResponseId = null;
        _planCopyFeedback = null;
        _selectedPlanTabIndex = 0;
        ClearPlanWorkoutEditor();
        StateHasChanged();

        try
        {
            var request = BuildPlanRequest();

            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, "/api/coach/plan")
            {
                Content = JsonContent.Create(request)
            };

            AppendCredentialHeaders(httpRequest);

            using var response = await Http.SendAsync(httpRequest);

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                _planErrorMessage = FormatRequestError("Plan", errorBody);
                return;
            }

            var planResponse = await response.Content.ReadFromJsonAsync<PlanResponse>();
            if (planResponse is null || string.IsNullOrWhiteSpace(planResponse.Content))
            {
                _planErrorMessage = "Plan request returned no content.";
                return;
            }

            var coachResponse = NormalizeCoachResponse(planResponse.Content);
            _planTotalTokens = planResponse.TotalTokens;
            _planResponseId = planResponse.ResponseId;

            var (planText, uploadJson) = SplitPlanAndUploadJson(coachResponse);

            _planReadableText = string.IsNullOrWhiteSpace(planText) ? null : planText;
            _planUploadJson = string.IsNullOrWhiteSpace(uploadJson) ? null : uploadJson;
            LoadPlanWorkoutEditor();
            _selectedPlanTabIndex = 0;

            if (_planReadableText is null && _planUploadJson is null)
            {
                _planErrorMessage = "Plan request returned no usable content.";
            }

            _isPlanExpanded = true;
        }
        catch
        {
            _planErrorMessage = "Plan request failed. Please try again.";
            _isPlanExpanded = true;
        }
        finally
        {
            _isPlanRequestInFlight = false;
            StateHasChanged();
        }
    }

    private async Task UploadPlanAsync()
    {
        if (_planWorkouts.Count > 0)
        {
            SyncPlanWorkoutsToUploadJson();
        }

        if (!CanUploadPlan || string.IsNullOrWhiteSpace(_planUploadJson))
        {
            return;
        }

        _isPlanUploadInFlight = true;
        _planUploaded = false;
        _planUploadFeedback = null;
        StateHasChanged();

        try
        {
            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, "/api/coach/plan/upload")
            {
                Content = JsonContent.Create(new { weekPlanJson = _planUploadJson })
            };

            AppendCredentialHeaders(httpRequest);

            using var response = await Http.SendAsync(httpRequest);

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                _planUploadFeedback = string.IsNullOrWhiteSpace(errorBody)
                    ? "Plan upload failed. Please try again."
                    : $"Plan upload failed: {errorBody}";
                return;
            }

            _planUploaded = true;
            _planUploadFeedback = "Plan uploaded successfully.";

            _isPlanUploadInFlight = false;
            StateHasChanged();

            await Task.Delay(1800);
            _planUploaded = false;
        }
        catch
        {
            _planUploaded = false;
            _planUploadFeedback = "Plan upload failed. Please try again.";
        }
        finally
        {
            _isPlanUploadInFlight = false;
            StateHasChanged();
        }
    }

