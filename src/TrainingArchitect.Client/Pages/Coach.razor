    private void AppendCredentialHeaders(HttpRequestMessage request)
    {
        var hasActiveCredentials = Session.TryGetActiveCredentials(out var activeAthleteId, out var activeApiKey);
        var athleteId = hasActiveCredentials
            ? activeAthleteId
            : (string.IsNullOrWhiteSpace(Session.AthleteId) ? _athleteId : Session.AthleteId);
        var apiKey = hasActiveCredentials ? activeApiKey : _apiKey;

        if (!string.IsNullOrWhiteSpace(athleteId))
        {
            request.Headers.TryAddWithoutValidation(IntervalsHeaders.AthleteId, athleteId);
        }

        if (!string.IsNullOrWhiteSpace(apiKey))
        {
            request.Headers.TryAddWithoutValidation(IntervalsHeaders.ApiKey, apiKey);
        }
    }

    private void InvalidateAssessResults()
    {
        foreach (var cardState in _assessCardStates.Values)
        {
            cardState.ResultText = null;
            cardState.IsLoading = false;
            cardState.ErrorMessage = null;
            cardState.CopyFeedback = null;
            cardState.ResponseId = null;
        }

        _expandedCard = null;
        _isAssessRequestInFlight = false;
        _isPlanRequestInFlight = false;
        _isPlanUploadInFlight = false;
        _isPlanExpanded = false;
        _planUploaded = false;
        _planReadableText = null;
        _planUploadJson = null;
        _planResponseId = null;
        _planTotalTokens = null;
        _planErrorMessage = null;
        _planCopyFeedback = null;
        _planUploadFeedback = null;
        ClearPlanWorkoutEditor();
    }

    private void HidePlanResult()
    {
        _isPlanExpanded = false;
    }

    private async Task CopyAssessResultAsync(AssessCardType cardType)
    {
        var state = GetAssessCardState(cardType);
        if (string.IsNullOrWhiteSpace(state.ResultText))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("trainingArchitect.copyText", state.ResultText);
            state.CopyFeedback = "Copied";
        }
        catch
        {
            state.CopyFeedback = "Copy failed";
        }

        StateHasChanged();

        await Task.Delay(1800);
        if (state.CopyFeedback is not null)
        {
            state.CopyFeedback = null;
            StateHasChanged();
        }
    }

    private async Task CopyAthleteJsonAsync()
    {
        if (!CanViewData)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("trainingArchitect.copyText", DataParsedPrettyJson);
            _statusCopyFeedback = "Copied";
        }
        catch
        {
            _statusCopyFeedback = "Copy failed";
        }

        StateHasChanged();

        await Task.Delay(1800);
        if (_statusCopyFeedback is not null)
        {
            _statusCopyFeedback = null;
            StateHasChanged();
        }
    }

    private void OpenDataView()
    {
        if (!CanViewData)
            return;

        _dataViewFeedback = string.Empty;
        _selectedDataViewTabIndex = 0;
        _showDataView = true;
    }

    private void CloseDataView()
    {
        _showDataView = false;
        _dataViewFeedback = string.Empty;
    }

    private async Task CopyJsonAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("trainingArchitect.copyText", DataParsedPrettyJson);
            _dataViewFeedback = "JSON copied to clipboard.";
        }
        catch
        {
            _dataViewFeedback = "Copy failed. Please copy manually from the JSON panel.";
        }
    }

    private async Task DownloadJsonAsync()
    {
        var fileName = BuildCoachInputFileName();

        await JS.InvokeVoidAsync("trainingArchitect.downloadText", fileName, DataParsedPrettyJson);
        _dataViewFeedback = "JSON file download started.";
    }

    private string BuildCoachInputFileName()
    {
        var parsed = Session.AthleteDataParsed;
        if (parsed is not null
            && parsed.Value.ValueKind == JsonValueKind.Object
            && parsed.Value.TryGetProperty("week_starting", out var weekStarting)
            && weekStarting.ValueKind == JsonValueKind.String)
        {
            var weekStartingText = weekStarting.GetString();
            if (DateOnly.TryParse(weekStartingText, out var weekStartingDate))
            {
                return $"coach_input_{weekStartingDate:yyyy-MM-dd}.json";
            }
        }

        return $"coach_input_{DateTime.UtcNow:yyyy-MM-dd}.json";
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        RestoreCoachViewState();

        try
        {
            var loaded = await CredentialStore.LoadAsync();
            if (loaded is not null)
            {
                _athleteId = loaded.Credential.AthleteId;
                _apiKey = loaded.Credential.ApiKey;
                _language = loaded.Credential.Language;
                _profileGoal = loaded.Credential.ProfileGoal;
                _remember = loaded.Durability == CredentialDurability.Persistent;
            }
        }
        catch
        {
            _initializationError = "Saved credentials could not be loaded. You can still enter credentials manually.";
        }

        try
        {
            await RefreshRememberedHintAsync();
        }
        catch
        {
            _showRememberedHint = false;
        }
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshRememberedHintAsync();
            }
            catch
            {
                _showRememberedHint = false;
            }

            StateHasChanged();
        });
    }

    private async Task RefreshRememberedHintAsync()
    {
        var loaded = await CredentialStore.LoadAsync();

        _showRememberedHint =
            loaded is not null
            && loaded.Durability == CredentialDurability.Persistent
            && !string.IsNullOrWhiteSpace(loaded.Credential.ApiKey)
            && (string.IsNullOrWhiteSpace(Session.AthleteId)
                || string.Equals(loaded.Credential.AthleteId, Session.AthleteId, StringComparison.Ordinal));
    }

    private void ToggleCredentialHelp()
    {
        _showCredentialHelp = !_showCredentialHelp;
    }

    private void CloseCredentialHelp()
    {
        _showCredentialHelp = false;
    }

    public void Dispose()
    {
        PersistCoachViewState();
        Session.Changed -= OnSessionChanged;
    }

    private void RestoreCoachViewState()
    {
        _planSchedulingPreference = CoachPageState.PlanSchedulingPreference;
        _openOverviewSectionTitle = CoachPageState.OpenOverviewSectionTitle;

        _assessCardStates[AssessCardType.MetricsWellness].ResultText = CoachPageState.MetricsResultText;
        _assessCardStates[AssessCardType.LastTraining].ResultText = CoachPageState.LastTrainingResultText;
        _assessCardStates[AssessCardType.Week].ResultText = CoachPageState.WeekResultText;
        _assessCardStates[AssessCardType.MetricsWellness].ResponseId = CoachPageState.MetricsResponseId;
        _assessCardStates[AssessCardType.LastTraining].ResponseId = CoachPageState.LastTrainingResponseId;
        _assessCardStates[AssessCardType.Week].ResponseId = CoachPageState.WeekResponseId;

        _assessCardStates[AssessCardType.MetricsWellness].TotalTokens = CoachPageState.MetricsTotalTokens;
        _assessCardStates[AssessCardType.LastTraining].TotalTokens = CoachPageState.LastTrainingTotalTokens;
        _assessCardStates[AssessCardType.Week].TotalTokens = CoachPageState.WeekTotalTokens;

        _assessCardStates[AssessCardType.MetricsWellness].ErrorMessage = CoachPageState.MetricsErrorMessage;
        _assessCardStates[AssessCardType.LastTraining].ErrorMessage = CoachPageState.LastTrainingErrorMessage;
        _assessCardStates[AssessCardType.Week].ErrorMessage = CoachPageState.WeekErrorMessage;

        _expandedCard = ParseAssessCardType(CoachPageState.ExpandedAssessCard);

        _isPlanExpanded = CoachPageState.IsPlanExpanded;
        _planReadableText = CoachPageState.PlanReadableText;
        _planUploadJson = CoachPageState.PlanUploadJson;
        _planErrorMessage = CoachPageState.PlanErrorMessage;
        _selectedPlanTabIndex = Math.Clamp(CoachPageState.SelectedPlanTabIndex, 0, 2);
        _planTotalTokens = CoachPageState.PlanTotalTokens;
        _planResponseId = CoachPageState.PlanResponseId;

        if (!string.IsNullOrWhiteSpace(_planUploadJson))
        {
            LoadPlanWorkoutEditor();
        }
    }

    private void PersistCoachViewState()
    {
        CoachPageState.PlanSchedulingPreference = _planSchedulingPreference;
        CoachPageState.OpenOverviewSectionTitle = _openOverviewSectionTitle;
        CoachPageState.ExpandedAssessCard = _expandedCard?.ToString();

        CoachPageState.MetricsResultText = _assessCardStates[AssessCardType.MetricsWellness].ResultText;
        CoachPageState.LastTrainingResultText = _assessCardStates[AssessCardType.LastTraining].ResultText;
        CoachPageState.WeekResultText = _assessCardStates[AssessCardType.Week].ResultText;
        CoachPageState.MetricsResponseId = _assessCardStates[AssessCardType.MetricsWellness].ResponseId;
        CoachPageState.LastTrainingResponseId = _assessCardStates[AssessCardType.LastTraining].ResponseId;
        CoachPageState.WeekResponseId = _assessCardStates[AssessCardType.Week].ResponseId;

        CoachPageState.MetricsTotalTokens = _assessCardStates[AssessCardType.MetricsWellness].TotalTokens;
        CoachPageState.LastTrainingTotalTokens = _assessCardStates[AssessCardType.LastTraining].TotalTokens;
        CoachPageState.WeekTotalTokens = _assessCardStates[AssessCardType.Week].TotalTokens;

        CoachPageState.MetricsErrorMessage = _assessCardStates[AssessCardType.MetricsWellness].ErrorMessage;
        CoachPageState.LastTrainingErrorMessage = _assessCardStates[AssessCardType.LastTraining].ErrorMessage;
        CoachPageState.WeekErrorMessage = _assessCardStates[AssessCardType.Week].ErrorMessage;

        CoachPageState.IsPlanExpanded = _isPlanExpanded;
        CoachPageState.PlanReadableText = _planReadableText;
        CoachPageState.PlanUploadJson = _planUploadJson;
        CoachPageState.PlanErrorMessage = _planErrorMessage;
        CoachPageState.SelectedPlanTabIndex = _selectedPlanTabIndex;
        CoachPageState.PlanTotalTokens = _planTotalTokens;
        CoachPageState.PlanResponseId = _planResponseId;
    }

    private static AssessCardType? ParseAssessCardType(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return Enum.TryParse<AssessCardType>(value, ignoreCase: true, out var parsed)
            ? parsed
            : null;
    }
}
