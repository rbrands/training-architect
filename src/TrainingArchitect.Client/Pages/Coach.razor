    private void ClearPlanWorkoutEditor()
    {
        _planUploadRoot = null;
        _planWorkouts.Clear();
        _planWeekDayOptions = [];
    }

    private void LoadPlanWorkoutEditor()
    {
        ClearPlanWorkoutEditor();

        if (string.IsNullOrWhiteSpace(_planUploadJson))
        {
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(_planUploadJson);
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object)
            {
                return;
            }

            _planUploadRoot = root.Clone();

            if (!root.TryGetProperty("workouts", out var workoutsElement) || workoutsElement.ValueKind != JsonValueKind.Array)
            {
                return;
            }

            foreach (var item in workoutsElement.EnumerateArray().Select((workout, index) => new { workout, index }))
            {
                if (item.workout.ValueKind != JsonValueKind.Object)
                {
                    continue;
                }

                var parsedWorkout = CreatePlanWorkoutViewModel(item.workout, item.index);
                if (parsedWorkout is null)
                {
                    continue;
                }

                _planWorkouts.Add(parsedWorkout);
            }

            _planWeekDayOptions = BuildPlanWeekDayOptions(_planWorkouts);
        }
        catch (JsonException)
        {
            ClearPlanWorkoutEditor();
        }
    }

    private static PlanWorkoutViewModel? CreatePlanWorkoutViewModel(JsonElement workout, int index)
    {
        var dateText = GetStringProperty(workout, "date");
        if (string.IsNullOrWhiteSpace(dateText) || !DateOnly.TryParse(dateText, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return null;
        }

        var tags = workout.TryGetProperty("tags", out var tagsElement) && tagsElement.ValueKind == JsonValueKind.Array
            ? tagsElement
                .EnumerateArray()
                .Where(tag => tag.ValueKind == JsonValueKind.String)
                .Select(tag => tag.GetString())
                .Where(tag => !string.IsNullOrWhiteSpace(tag))
                .Select(tag => tag!)
                .ToArray()
            : [];

        return new PlanWorkoutViewModel
        {
            Id = $"workout-{index}",
            Date = date,
            Name = GetStringProperty(workout, "name") ?? $"Workout {index + 1}",
            DurationMinutes = GetIntProperty(workout, "duration_minutes"),
            Tags = tags,
            OriginalWorkout = workout.Clone()
        };
    }

    private static IReadOnlyList<PlanWeekDayOption> BuildPlanWeekDayOptions(IEnumerable<PlanWorkoutViewModel> workouts)
    {
        var workoutDates = workouts.Select(workout => workout.Date).ToArray();
        if (workoutDates.Length == 0)
        {
            return [];
        }

        var earliest = workoutDates.Min();
        var mondayOffset = earliest.DayOfWeek switch
        {
            DayOfWeek.Sunday => 6,
            _ => (int)earliest.DayOfWeek - 1
        };

        var weekStart = earliest.AddDays(-mondayOffset);

        return Enumerable.Range(0, 7)
            .Select(offset => weekStart.AddDays(offset))
            .Select(date => new PlanWeekDayOption(
                FormatPlanWorkoutDateValue(date),
                date.ToDateTime(TimeOnly.MinValue).ToString("ddd dd MMM", PlanWeekCulture),
                date))
            .ToArray();
    }

    private void OnPlanWorkoutDateChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args, string workoutId)
    {
        if (args.Value is not string selectedDate
            || !DateOnly.TryParse(selectedDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
        {
            return;
        }

        var workout = _planWorkouts.FirstOrDefault(item => string.Equals(item.Id, workoutId, StringComparison.Ordinal));
        if (workout is null || workout.Date == parsedDate)
        {
            return;
        }

        workout.Date = parsedDate;
        _planUploaded = false;
        _planUploadFeedback = null;
        _planCopyFeedback = null;
        SyncPlanWorkoutsToUploadJson();
        StateHasChanged();
    }

    private void SyncPlanWorkoutsToUploadJson()
    {
        if (_planUploadRoot is null)
        {
            return;
        }

        _planUploadJson = SerializePlanUploadJson(_planUploadRoot.Value, _planWorkouts);
    }

    private static string SerializePlanUploadJson(JsonElement root, IReadOnlyList<PlanWorkoutViewModel> workouts)
    {
        using var stream = new MemoryStream();
        using var writer = new Utf8JsonWriter(stream, new JsonWriterOptions
        {
            Indented = true
        });

        writer.WriteStartObject();
        var wroteWorkouts = false;

        foreach (var property in root.EnumerateObject())
        {
            if (property.NameEquals("workouts"))
            {
                writer.WritePropertyName("workouts");
                WritePlanWorkouts(writer, workouts);
                wroteWorkouts = true;
                continue;
            }

            property.WriteTo(writer);
        }

        if (!wroteWorkouts)
        {
            writer.WritePropertyName("workouts");
            WritePlanWorkouts(writer, workouts);
        }

        writer.WriteEndObject();
        writer.Flush();

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static void WritePlanWorkouts(Utf8JsonWriter writer, IReadOnlyList<PlanWorkoutViewModel> workouts)
    {
        writer.WriteStartArray();

        foreach (var workout in workouts)
        {
            WritePlanWorkout(writer, workout);
        }

        writer.WriteEndArray();
    }

    private static void WritePlanWorkout(Utf8JsonWriter writer, PlanWorkoutViewModel workout)
    {
        writer.WriteStartObject();

        var wroteDate = false;
        foreach (var property in workout.OriginalWorkout.EnumerateObject())
        {
            if (property.NameEquals("date"))
            {
                writer.WriteString("date", FormatPlanWorkoutDateValue(workout.Date));
                wroteDate = true;
                continue;
            }

            property.WriteTo(writer);
        }

        if (!wroteDate)
        {
            writer.WriteString("date", FormatPlanWorkoutDateValue(workout.Date));
        }

        writer.WriteEndObject();
    }

