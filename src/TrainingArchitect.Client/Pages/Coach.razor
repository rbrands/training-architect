    private static readonly CultureInfo PlanWeekCulture = CultureInfo.GetCultureInfo("en-GB");

    private IReadOnlyList<JsonOverviewSection> OverviewSections => BuildOverviewSections();
    private string? _openOverviewSectionTitle;

    private IReadOnlyList<JsonOverviewSection> BuildOverviewSections()
    {
        var root = GetOverviewRoot();
        if (root is null)
        {
            return [];
        }

        var sections = new List<JsonOverviewSection>();
        var knownSectionKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "metrics",
            "week_summary",
            "activities",
            "fueling_analysis",
            "planned_workouts"
        };

        var headerProperties = new Dictionary<string, JsonElement>(StringComparer.OrdinalIgnoreCase);
        foreach (var property in root.Value.EnumerateObject())
        {
            if (knownSectionKeys.Contains(property.Name))
            {
                continue;
            }

            if (property.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
            {
                continue;
            }

            headerProperties[property.Name] = property.Value;
        }

        if (headerProperties.Count > 0)
        {
            sections.Add(new JsonOverviewSection(
                "Header Data",
                $"{headerProperties.Count} fields",
                SerializePretty(headerProperties)));
        }

        AddOverviewSection(sections, root.Value, "metrics", "Metrics");
        AddOverviewSection(sections, root.Value, "week_summary", "Week Summary");
        AddOverviewSection(sections, root.Value, "activities", "Activities");
        AddOverviewSection(sections, root.Value, "fueling_analysis", "Fueling Analysis");
        AddOverviewSection(sections, root.Value, "planned_workouts", "Planned Workouts");

        return sections;
    }

    private JsonElement? GetOverviewRoot()
    {
        var parsed = Session.AthleteDataParsed;
        if (parsed is not null && parsed.Value.ValueKind == JsonValueKind.Object)
        {
            return parsed;
        }

        var fallbackJson = Session.AthleteDataJson;
        if (string.IsNullOrWhiteSpace(fallbackJson))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(fallbackJson);
            var root = document.RootElement.Clone();
            return root.ValueKind == JsonValueKind.Object ? root : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static void AddOverviewSection(
        List<JsonOverviewSection> sections,
        JsonElement root,
        string key,
        string title)
    {
        if (!root.TryGetProperty(key, out var value))
        {
            return;
        }

        sections.Add(new JsonOverviewSection(
            title,
            BuildSectionSummary(value),
            SerializePretty(value)));
    }

    private static string BuildSectionSummary(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.Object => $"{value.EnumerateObject().Count()} fields",
            JsonValueKind.Array => $"{value.GetArrayLength()} items",
            JsonValueKind.String => "text value",
            JsonValueKind.Number => "numeric value",
            JsonValueKind.True or JsonValueKind.False => "boolean value",
            JsonValueKind.Null => "null",
            _ => "value"
        };
    }

    private static string SerializePretty<TValue>(TValue value)
    {
        return JsonSerializer.Serialize(value, new JsonSerializerOptions
        {
            WriteIndented = true
        });
    }

    private bool IsOverviewSectionOpen(JsonOverviewSection section)
    {
        return !string.IsNullOrWhiteSpace(_openOverviewSectionTitle)
            && string.Equals(_openOverviewSectionTitle, section.Title, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleOverviewSection(JsonOverviewSection section)
    {
        if (IsOverviewSectionOpen(section))
        {
            _openOverviewSectionTitle = null;
            return;
        }

        _openOverviewSectionTitle = section.Title;
    }

    private static JsonElement? GetObjectProperty(JsonElement? parent, string propertyName)
    {
        var property = GetAnyProperty(parent, propertyName);
        if (property is null || property.Value.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        return property;
    }

    private static JsonElement? GetAnyProperty(JsonElement? parent, string propertyName)
    {
        if (parent is null || parent.Value.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        return parent.Value.TryGetProperty(propertyName, out var value)
            ? value
            : null;
    }

    private static JsonElement? GetNestedProperty(JsonElement? parent, params string[] path)
    {
        var current = parent;

        foreach (var segment in path)
        {
            current = GetAnyProperty(current, segment);
            if (current is null)
            {
                return null;
            }
        }

        return current;
    }

    private IReadOnlyList<MetricsSnapshot.MetricSnapshotItem> BuildMetricsSnapshot()
    {
        var root = GetOverviewRoot();
        var metrics = GetObjectProperty(root, "metrics");
        var weekSummary = GetObjectProperty(root, "week_summary");
        var fuelingFormAnalysis = GetNestedProperty(weekSummary, "fueling_form_analysis");

        var items = new List<MetricsSnapshot.MetricSnapshotItem>
        {
            new("FTP", FormatMetricValue(GetAnyProperty(metrics, "ftp"), "W")),
            new("eFTP", FormatMetricValue(GetAnyProperty(metrics, "eftp"), "W")),
            new("FTP w/kg", FormatMetricValue(GetNestedProperty(metrics, "ftp_classification", "w_per_kg"))),
            new("FTP Category", FormatMetricValue(GetNestedProperty(metrics, "ftp_classification", "category"))),
            new("Power Profile Type", FormatMetricValue(GetNestedProperty(metrics, "power_profile", "type"))),
            new("VO2max ml/kg/min", FormatMetricValue(GetNestedProperty(metrics, "vo2max_classification", "ml_per_kg_min"))),
            new("VO2max Age Group", FormatMetricValue(GetNestedProperty(metrics, "vo2max_classification", "age_group"))),
            new("VO2max Category", FormatMetricValue(GetNestedProperty(metrics, "vo2max_classification", "category")))
        };

        if (fuelingFormAnalysis is not null)
        {
            AddSnapshotItem(items, fuelingFormAnalysis, "fatigue_status", "Fatigue Status");
            AddSnapshotItem(items, fuelingFormAnalysis, "fueling_status", "Fueling Status");
            AddSnapshotItem(items, fuelingFormAnalysis, "avg_carbs_per_hour", "Avg. Carbs/h");
            AddSnapshotItem(items, fuelingFormAnalysis, "avg_fueling_ratio", "Avg. Fueling Ratio");
            AddSnapshotItem(items, fuelingFormAnalysis, "underfueled_sessions", "Underfueled Sessions");
            AddSnapshotItem(items, fuelingFormAnalysis, "number_of_long_rides", "Long Rides");
            AddSnapshotItem(items, fuelingFormAnalysis, "durability_limited_by_fueling", "Durability Limited by Fueling");
            AddSnapshotItem(items, fuelingFormAnalysis, "interpretation", "Interpretation");
            AddSnapshotItem(items, fuelingFormAnalysis, "recommendation", "Recommendation");
            AddSnapshotItem(items, fuelingFormAnalysis, "long_ride_advice", "Long Ride Advice");
        }

        return items;
    }

    private static void AddSnapshotItem(ICollection<MetricsSnapshot.MetricSnapshotItem> items, JsonElement? parent, string propertyName, string label)
    {
        if (parent is null || parent.Value.ValueKind != JsonValueKind.Object)
        {
            return;
        }

        if (!parent.Value.TryGetProperty(propertyName, out var value))
        {
            return;
        }

        var text = value.ValueKind switch
        {
            JsonValueKind.String => value.GetString(),
            JsonValueKind.Number => FormatNumber(value),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            JsonValueKind.Null => "n/a",
            _ => value.GetRawText()
        };

        if (!string.IsNullOrWhiteSpace(text))
        {
            items.Add(new MetricsSnapshot.MetricSnapshotItem(label, text));
        }
    }

    private MetricsSnapshot.FitnessKpiSnapshot? BuildFitnessKpis()
    {
        var root = GetOverviewRoot();
        if (root is null)
        {
            return null;
        }

        var ctl = FindNumericProperty(root.Value, "ctl");
        var atl = FindNumericProperty(root.Value, "atl");
        var tsb = FindNumericProperty(root.Value, "tsb") ?? FindNumericProperty(root.Value, "form");
        var formPercentDisplay = FindPreferredFormDisplay(root.Value);
        var formPercent = FindNumericProperty(root.Value, "form_pct")
            ?? FindNumericProperty(root.Value, "form_percent")
            ?? FindNumericProperty(root.Value, "tsb_percent");
        var formZone = NormalizeFormZone(FindStringProperty(root.Value, "form_zone"));

        if (ctl is null || atl is null)
        {
            return null;
        }

        return new MetricsSnapshot.FitnessKpiSnapshot(
            ctl.Value,
            atl.Value,
            tsb ?? (ctl.Value - atl.Value),
            formPercentDisplay,
            formPercent,
            formZone ?? DetermineFormZone(formPercent));
    }

    private static double? FindNumericProperty(JsonElement element, string propertyName)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase)
                    && TryReadDouble(property.Value, out var directValue))
                {
                    return directValue;
                }

                var nestedValue = FindNumericProperty(property.Value, propertyName);
                if (nestedValue is not null)
                {
                    return nestedValue;
                }
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
            {
                var nestedValue = FindNumericProperty(item, propertyName);
                if (nestedValue is not null)
                {
                    return nestedValue;
                }
            }
        }

        return null;
    }

    private static string? FindStringProperty(JsonElement element, string propertyName)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase)
                    && property.Value.ValueKind == JsonValueKind.String)
                {
                    var directValue = property.Value.GetString();
                    if (!string.IsNullOrWhiteSpace(directValue))
                    {
                        return directValue;
                    }
                }

                var nestedValue = FindStringProperty(property.Value, propertyName);
                if (!string.IsNullOrWhiteSpace(nestedValue))
                {
                    return nestedValue;
                }
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
            {
                var nestedValue = FindStringProperty(item, propertyName);
                if (!string.IsNullOrWhiteSpace(nestedValue))
                {
                    return nestedValue;
                }
            }
        }

        return null;
    }

    private static string? FindPreferredFormDisplay(JsonElement element)
    {
        var displayText = FindStringProperty(element, "form_percent_display")
            ?? FindStringProperty(element, "form_display")
            ?? FindStringProperty(element, "tsb_percent_display");

        if (!string.IsNullOrWhiteSpace(displayText))
        {
            return displayText;
        }

        var directDisplayValue = FindNumericProperty(element, "form_percent_display")
            ?? FindNumericProperty(element, "tsb_percent_display");

        if (directDisplayValue is not null)
        {
            return FormatPercentValue(directDisplayValue.Value);
        }

        var percentValue = FindNumericProperty(element, "form_percent")
            ?? FindNumericProperty(element, "form_pct")
            ?? FindNumericProperty(element, "tsb_percent");

        if (percentValue is null)
        {
            return null;
        }

        return FormatPercentValue(percentValue.Value * 100);
    }

    private static bool TryReadDouble(JsonElement value, out double result)
    {
        if (value.ValueKind == JsonValueKind.Number)
        {
            return value.TryGetDouble(out result);
        }

        if (value.ValueKind == JsonValueKind.String)
        {
            return double.TryParse(value.GetString(), CultureInfo.InvariantCulture, out result);
        }

        result = default;
        return false;
    }

    private static string FormatPercentValue(double value)
    {
        var prefix = value >= 0 ? "+" : string.Empty;
        return $"{prefix}{value.ToString("0.0", CultureInfo.InvariantCulture)} %";
    }

    private static string? DetermineFormZone(double? formPercent)
    {
        if (formPercent is null)
        {
            return null;
        }

        return formPercent.Value switch
        {
            > 0.20 => "transition",
            >= 0.05 => "fresh",
            >= -0.10 => "grey_zone",
            >= -0.30 => "optimal",
            _ => "high_risk"
        };
    }

    private static string? NormalizeFormZone(string? formZone)
    {
        if (string.IsNullOrWhiteSpace(formZone))
        {
            return null;
        }

        return formZone.Trim().ToLowerInvariant();
    }

    private static string FormatMetricValue(JsonElement? value, string? unit = null)
    {
        if (value is null)
        {
            return "n/a";
        }

        var element = value.Value;
        var text = element.ValueKind switch
        {
            JsonValueKind.Number => FormatNumber(element),
            JsonValueKind.String => element.GetString(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            _ => null
        };

        if (string.IsNullOrWhiteSpace(text))
        {
            return "n/a";
        }

        return string.IsNullOrWhiteSpace(unit)
            ? text
            : $"{text} {unit}";
    }

    private static string FormatNumber(JsonElement numberElement)
    {
        if (numberElement.TryGetInt64(out var integerValue))
        {
            return integerValue.ToString(CultureInfo.InvariantCulture);
        }

        if (numberElement.TryGetDouble(out var doubleValue))
        {
            return doubleValue.ToString("0.##", CultureInfo.InvariantCulture);
        }

        return numberElement.GetRawText();
    }

    private static MarkupString RenderAssessMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return new MarkupString(string.Empty);
        }

        var normalized = NormalizeSectionNumbering(markdown);
        return new MarkupString(Markdown.ToHtml(normalized, AssessMarkdownPipeline));
    }

    private static string NormalizeSectionNumbering(string markdown)
    {
        var normalized = markdown.Replace("\r\n", "\n", StringComparison.Ordinal);
        var lines = normalized.Split('\n');
        var sectionCounter = 0;

        for (var index = 0; index < lines.Length; index++)
        {
            var line = lines[index];
            var sectionMatch = Regex.Match(line, @"^\s*\d+\.\s+(.+:)\s*$");
            if (!sectionMatch.Success)
            {
                continue;
            }

            sectionCounter++;
            lines[index] = $"{sectionCounter}. {sectionMatch.Groups[1].Value}";
        }

        return string.Join("\n", lines);
    }

    private string DataParsedPrettyJson
    {
        get
        {
            var parsed = Session.AthleteDataParsed;
            if (parsed is null)
            {
                return string.IsNullOrWhiteSpace(Session.AthleteDataJson) ? "{}" : Session.AthleteDataJson;
            }

            return JsonSerializer.Serialize(parsed.Value, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
    }

    private string DataRawPrettyJson
    {
        get
        {
            var raw = Session.AthleteDataRaw;
            if (string.IsNullOrWhiteSpace(raw))
            {
                return "{}";
            }

            try
            {
                using var document = JsonDocument.Parse(raw);
                return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
            catch (JsonException)
            {
                return raw;
            }
        }
    }

    private string DataMethodName => string.IsNullOrWhiteSpace(Session.AthleteDataMethodName)
        ? "n/a"
        : Session.AthleteDataMethodName;

    private static string FormatConnectionError(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return string.Empty;
        }

        if (TryExtractConnectionError(message, out var conciseMessage))
        {
            return conciseMessage;
        }

        return message.Trim();
    }

    private static string FormatRequestError(string requestType, string? message)
    {
        var fallback = $"{requestType} request failed. Please try again.";
        if (string.IsNullOrWhiteSpace(message))
        {
            return fallback;
        }

        if (TryExtractRequestErrorText(message, out var endpointMessage))
        {
            return endpointMessage;
        }

        return message.Trim();
    }

    private static bool TryExtractRequestErrorText(string message, out string endpointMessage)
    {
        endpointMessage = string.Empty;

        try
        {
            using var document = JsonDocument.Parse(message);
            if (!TryFindErrorPayload(document.RootElement, out var payload))
            {
                return false;
            }

            var errorText = GetStringProperty(payload, "error");
            if (string.IsNullOrWhiteSpace(errorText))
            {
                return false;
            }

            endpointMessage = errorText.Trim();
            return true;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private static string GetErrorCssClass(string? message)
    {
        return IsTokenLimitError(message)
            ? "coach-assess-error coach-assess-error-limit"
            : "coach-assess-error";
    }

    private static bool IsTokenLimitError(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return false;
        }

        return message.Contains("Monthly token limit", StringComparison.OrdinalIgnoreCase)
            || message.Contains("Weekly token limit", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryExtractConnectionError(string message, out string conciseMessage)
    {
        conciseMessage = string.Empty;

        try
        {
            using var document = JsonDocument.Parse(message);
            if (!TryFindErrorPayload(document.RootElement, out var payload))
            {
                return false;
            }

            var errorText = GetStringProperty(payload, "error");
            if (string.IsNullOrWhiteSpace(errorText))
            {
                return false;
            }

            var hintText = GetHintText(payload);
            conciseMessage = string.IsNullOrWhiteSpace(hintText)
                ? errorText.Trim()
                : $"{errorText.Trim()} {hintText.Trim()}";
            return true;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private static bool TryFindErrorPayload(JsonElement element, out JsonElement payload)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            if (!string.IsNullOrWhiteSpace(GetStringProperty(element, "error")))
            {
                payload = element;
                return true;
            }

            foreach (var propertyName in new[] { "dataParsed", "result" })
            {
                if (!element.TryGetProperty(propertyName, out var property))
                {
                    continue;
                }

                if (property.ValueKind == JsonValueKind.String)
                {
                    var text = property.GetString();
                    if (!string.IsNullOrWhiteSpace(text))
                    {
                        try
                        {
                            using var nested = JsonDocument.Parse(text);
                            if (TryFindErrorPayload(nested.RootElement, out payload))
                            {
                                return true;
                            }
                        }
                        catch (JsonException)
                        {
                            // Ignore non-JSON strings.
                        }
                    }
                }

                if (property.ValueKind == JsonValueKind.Object && TryFindErrorPayload(property, out payload))
                {
                    return true;
                }
            }
        }

        payload = default;
        return false;
    }

    private static string? GetHintText(JsonElement element)
    {
        var directHint = GetStringProperty(element, "hint");
        if (!string.IsNullOrWhiteSpace(directHint))
        {
            return directHint;
        }

        var logText = GetStringProperty(element, "log");
        if (string.IsNullOrWhiteSpace(logText))
        {
            return null;
        }

        var hintIndex = logText.IndexOf("Hint:", StringComparison.OrdinalIgnoreCase);
        if (hintIndex < 0)
        {
            return null;
        }

        var hintText = logText[(hintIndex + "Hint:".Length)..].Trim();
        return string.IsNullOrWhiteSpace(hintText) ? null : hintText;
    }

    private static string? GetStringProperty(JsonElement element, string propertyName)
    {
        if (element.ValueKind != JsonValueKind.Object ||
            !element.TryGetProperty(propertyName, out var property) ||
            property.ValueKind != JsonValueKind.String)
        {
            return null;
        }

        var value = property.GetString();
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static int? GetIntProperty(JsonElement element, string propertyName)
    {
        if (element.ValueKind != JsonValueKind.Object ||
            !element.TryGetProperty(propertyName, out var property) ||
            property.ValueKind != JsonValueKind.Number)
        {
            return null;
        }

        return property.TryGetInt32(out var value) ? value : null;
    }

