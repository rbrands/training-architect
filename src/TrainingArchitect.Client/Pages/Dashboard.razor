@page "/dashboard"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IIntervalsDataProvider IntervalsData

<PageTitle>Dashboard · Training Architect</PageTitle>

<h1 class="fw-bold mb-1">📊 Training Dashboard</h1>
<p class="text-secondary small mb-4">
    Fitness, fatigue and form — powered by
    <span class="text-secondary">intervals.icu</span> data.
</p>

@if (_snapshot is null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-secondary" role="status">
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>
}
else
{
    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-4">
            <div class="card-dark p-3 text-center">
                <div class="text-secondary small text-uppercase fw-semibold mb-1"
                     style="font-size:0.7rem; letter-spacing:0.05em;">CTL (Fitness)</div>
                <div class="fw-bold" style="font-size:1.75rem; color:#4dabf7;">
                    @_snapshot.CtlToday.ToString("F1")
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card-dark p-3 text-center">
                <div class="text-secondary small text-uppercase fw-semibold mb-1"
                     style="font-size:0.7rem; letter-spacing:0.05em;">ATL (Fatigue)</div>
                <div class="fw-bold" style="font-size:1.75rem; color:#f783ac;">
                    @_snapshot.AtlToday.ToString("F1")
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card-dark p-3 text-center">
                <div class="text-secondary small text-uppercase fw-semibold mb-1"
                     style="font-size:0.7rem; letter-spacing:0.05em;">TSB (Form)</div>
                <div class="fw-bold @(_snapshot.TsbToday >= 0 ? "text-success" : "text-warning")"
                     style="font-size:1.75rem;">
                    @(_snapshot.TsbToday >= 0 ? "+" : "")@_snapshot.TsbToday.ToString("F1")
                </div>
            </div>
        </div>
    </div>

    <!-- Progression chart -->
    <div class="card-dark p-3">
        <h6 class="text-secondary small fw-semibold mb-3 text-uppercase"
            style="font-size:0.75rem; letter-spacing:0.05em;">
            28-Day Progression
        </h6>
        <FitnessChart History="_snapshot.FitnessHistory" />
    </div>

    <p class="text-secondary mt-3" style="font-size:0.7rem;">
        ⚙️ Sample data — TODO: connect to live intervals.icu API via
        <code>IIntervalsDataProvider</code>.
    </p>
}

@code {
    private AthleteSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        // TODO: Retrieve real athlete ID from IAuthContext once server-side auth is wired up.
        _snapshot = await IntervalsData.GetSnapshotAsync("dev-athlete-001");
    }
}
