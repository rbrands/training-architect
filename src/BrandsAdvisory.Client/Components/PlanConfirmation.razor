@using BrandsAdvisory.Core.Models

@*
    Human-in-the-loop plan confirmation component.
    Rendered with InteractiveWebAssembly when embedded from the TrainingPlan SSR page.

    TODO: Connect OnDecision to the orchestration layer so the agent can
          incorporate athlete feedback before finalising the plan.
*@

@if (Plan is null)
{
    <div class="alert alert-secondary small">No plan loaded yet.</div>
}
else if (_decided)
{
    <div class="alert @_alertClass small">
        <strong>@_decisionLabel</strong>
        @if (!string.IsNullOrWhiteSpace(_adjustNote))
        {
            <span> — "@_adjustNote"</span>
        }
        <br />
        <span class="text-secondary">TODO: forward decision to the orchestration layer.</span>
    </div>
}
else
{
    <div class="card-dark p-3">
        <h6 class="fw-semibold mb-2">📋 @Plan.Title</h6>
        <p class="text-secondary small mb-3">@Plan.Description</p>

        <div class="d-flex align-items-center gap-2 small mb-3">
            <span class="text-secondary">Week starting:</span>
            <strong>@Plan.WeekStarting.ToString("d MMM yyyy")</strong>
            <span class="text-secondary ms-2">Weekly TSS:</span>
            <strong>@Plan.WeeklyTss.ToString("F0")</strong>
        </div>

        @if (_showAdjustBox)
        {
            <div class="mb-3">
                <label class="form-label small text-secondary">Adjustment notes for the coach:</label>
                <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                          rows="3"
                          placeholder="e.g. I can't ride on Thursday this week…"
                          @bind="_adjustNote" />
            </div>
        }

        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-success" @onclick="Accept">
                ✅ Accept plan
            </button>
            <button class="btn btn-sm btn-outline-warning" @onclick="ToggleAdjust">
                ✏️ @(_showAdjustBox ? "Submit adjustment" : "Request adjustment")
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="Reject">
                ❌ Reject plan
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TrainingPlan? Plan { get; set; }

    /// <summary>
    /// Raised when the athlete makes a decision.
    /// TODO: Connect to the orchestration agent to act on the decision.
    /// </summary>
    [Parameter]
    public EventCallback<PlanDecision> OnDecision { get; set; }

    private bool _decided;
    private bool _showAdjustBox;
    private string _adjustNote = string.Empty;
    private string _decisionLabel = string.Empty;
    private string _alertClass = string.Empty;

    private async Task Accept()
    {
        _decisionLabel = "Plan accepted — handing off to the orchestration layer.";
        _alertClass = "alert-success";
        _decided = true;
        await OnDecision.InvokeAsync(new PlanDecision(PlanDecisionType.Accepted, string.Empty));
    }

    private async Task ToggleAdjust()
    {
        if (_showAdjustBox && !string.IsNullOrWhiteSpace(_adjustNote))
        {
            _decisionLabel = "Adjustment requested.";
            _alertClass = "alert-warning";
            _decided = true;
            await OnDecision.InvokeAsync(new PlanDecision(PlanDecisionType.AdjustmentRequested, _adjustNote));
        }
        else
        {
            _showAdjustBox = !_showAdjustBox;
        }
    }

    private async Task Reject()
    {
        _decisionLabel = "Plan rejected — the coach will generate a revised proposal.";
        _alertClass = "alert-danger";
        _decided = true;
        await OnDecision.InvokeAsync(new PlanDecision(PlanDecisionType.Rejected, string.Empty));
    }
}
