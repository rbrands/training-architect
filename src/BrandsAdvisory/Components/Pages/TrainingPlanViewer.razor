@*
    Static SSR component — renders the structured training plan table.
    No interactivity required; keep this as pure markup.
*@
@using BrandsAdvisory.Core.Models

@if (Plan is null)
{
    <div class="alert alert-secondary small">No plan available yet.</div>
}
else
{
    <div class="card-dark p-3 mb-3">
        <h5 class="fw-semibold mb-1">@Plan.Title</h5>
        <p class="text-secondary small mb-2">@Plan.Description</p>
        <div class="d-flex gap-3 small text-secondary">
            <span>Week of <strong class="text-white">@Plan.WeekStarting.ToString("d MMM yyyy")</strong></span>
            <span>Total TSS <strong class="text-white">@Plan.WeeklyTss.ToString("F0")</strong></span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm mb-0" style="font-size:0.85rem;">
            <thead>
                <tr class="text-secondary text-uppercase" style="font-size:0.7rem; letter-spacing:0.04em;">
                    <th>Day</th>
                    <th>Workout</th>
                    <th class="text-center">Type</th>
                    <th class="text-center">Duration</th>
                    <th class="text-center">Zone</th>
                    <th class="text-center">TSS</th>
                    <th class="text-center">IF</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Plan.Workouts)
                {
                    <tr>
                        <td class="text-secondary" style="white-space:nowrap;">@w.Day</td>
                        <td>
                            <div class="fw-semibold">@w.Title</div>
                            <div class="text-secondary small">@w.Description</div>
                        </td>
                        <td class="text-center">
                            <span class="badge @TypeBadgeClass(w.Type)">@w.Type</span>
                        </td>
                        <td class="text-center text-secondary">
                            @(w.DurationMinutes > 0 ? $"{w.DurationMinutes} min" : "—")
                        </td>
                        <td class="text-center text-secondary">@(string.IsNullOrEmpty(w.Zone) ? "—" : w.Zone)</td>
                        <td class="text-center">
                            @(w.Tss > 0 ? w.Tss.ToString("F0") : "—")
                        </td>
                        <td class="text-center text-secondary">
                            @(w.IntensityFactor > 0 ? w.IntensityFactor.ToString("F2") : "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TrainingPlan? Plan { get; set; }

    private static string TypeBadgeClass(WorkoutType type) => type switch
    {
        WorkoutType.Rest => "bg-secondary",
        WorkoutType.Endurance => "bg-info text-dark",
        WorkoutType.Tempo => "bg-primary",
        WorkoutType.Threshold => "bg-warning text-dark",
        WorkoutType.VO2Max => "bg-danger",
        WorkoutType.Race => "bg-success",
        _ => "bg-secondary"
    };
}
